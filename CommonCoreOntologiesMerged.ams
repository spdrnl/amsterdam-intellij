@annotation( rdfs:label "is about"@en )
@annotation( skos:definition "A primitive relationship between an Information Content Entity and some Entity."@en )
@annotation( cco:ont00001754 "http://purl.obolibrary.org/obo/IAO_0000136" )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Object property cco:ont00001808 ;
    has domain cco:ont00000958 ;
    has range obo:BFO_0000001.

@annotation( rdfs:label "inheres in aggregate"@en )
@annotation( skos:definition "x inheres_in_aggregate y iff x is an instance of Specifically Dependent Continuant and y is an instance of Object Aggregate and z is an instance of Object, such that z bearer_of x, and all other members of y are bearers of a unique instance of the same type as x."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001809 ;
    has domain ( obo:BFO_0000020 ⊔ obo:BFO_0000031 ) ;
    has range obo:BFO_0000027 ;
    is inverse of cco:ont00001836.

@annotation( rdfs:label "connected with"@en )
@annotation( skos:definition "An immaterial entity im1 is connected with some immaterial entity im2 iff there exists some immaterial entity im3 that is common to both im1 and im2."@en )
@annotation( skos:scopeNote "Given a stronger temporal interpretation, this property may be symmetric. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI )
Object property cco:ont00001810 ;
    has domain obo:BFO_0000141 ;
    has range obo:BFO_0000141.

@annotation( rdfs:label "is a ordinal measurement of"@en )
@annotation( skos:definition "x is_a_ordinal_measurement_of y iff x is an instance of Information Content Entity and y is an instance of Entity, such that x describes some attribute of y relative to a scale ordered by rank."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Object property cco:ont00001811 ;
    ⊑ cco:ont00001966 ;
    has domain cco:ont00001010 ;
    is inverse of cco:ont00001963.

@annotation( rdfs:label "is grandson of"@en )
