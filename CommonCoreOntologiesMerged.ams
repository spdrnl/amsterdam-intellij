Object property cco:ont00001812 ;
    ⊑ cco:ont00001945 ;
    is inverse of cco:ont00001981.

@annotation( rdfs:label "uses"@en )
@annotation( skos:definition "x uses y iff x is an instance of an Agent and y is an instance of a Material Entity, such that both x and y participate in some instance of a Process wherein x attempts to accomplish a goal by manipulating, deploying, or leveraging some attribute of y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001813 ;
    is inverse of cco:ont00001925.

@annotation( rdfs:label "interval finishes"@en )
@annotation( skos:definition "A Temporal Interval INT1 finishes some Temporal Interval INT2 iff there exists Temporal Instants inst1, inst2, and inst3 such that inst 1 is the starting instant of INT1, inst2 is the ending instant of both INT1 and INT2, inst3 is the starting instant of INT2, and inst3 is before inst1."@en )
@annotation( cco:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI )
Object property cco:ont00001814 ;
    ⊑ cco:ont00001971 ;
    has domain obo:BFO_0000038 ;
    has range obo:BFO_0000038 ;
    is inverse of cco:ont00001821.

@annotation( rdfs:label "is subsidiary of"@en )
@annotation( skos:definition "An Organization o2 is_subsidiary_of Organization o1 iff o1 controls o2 by having the capacity to determine the outcome of decisions about o2's financial and operating policies. "@en )
@annotation( cco:ont00001754 "http://www.austlii.edu.au/legis/cth/consol_act/ca2001172/s50aa.html)" )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001815 ;
    ⊑ cco:ont00001939 ;
    has domain cco:ont00001180 ;
    has range cco:ont00001180.

@annotation( rdfs:label "is output of"@en )
@annotation( skos:definition "x is_output_of y iff x is an instance of Continuant and y is an instance of Process, such that the presence of x at the end of y is a necessary condition for the completion of y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001816 ;
    ⊑ obo:BFO_0000056 ;
    has domain obo:BFO_0000002 ;
    has range obo:BFO_0000015 ;
    is inverse of cco:ont00001986.

@annotation( rdfs:label "is prohibited by"@en )
@annotation( skos:definition "y is_prohibited_by y at t iff: x is an instance of Process Regulation at time t, and y is an instance of Process at time t, and x prescribes that y must not occur."@en )
@annotation( skos:scopeNote "Given a stronger temporal interpretation, this property may be asymmetric and irreflexive. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001817 ;
    ⊑ cco:ont00001920 ;
    has domain obo:BFO_0000015 ;
    has range cco:ont00001324.

