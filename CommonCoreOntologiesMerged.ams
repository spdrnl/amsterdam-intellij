@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001818 ;
    ⊑ cco:ont00001865 ;
    is inverse of cco:ont00001818.

@annotation( rdfs:label "caused by"@en )
@annotation( skos:definition "x caused_by y iff x and y are instances of Occurrent, and x is a consequence of y."@en )
