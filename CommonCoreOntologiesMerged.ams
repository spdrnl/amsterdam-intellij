Object property cco:ont00001797 ;
    ⊑ cco:ont00001810 ;
    has domain obo:BFO_0000141 ;
    has range obo:BFO_0000141.

@annotation( rdfs:label "is supervised by"@en )
@annotation( skos:definition "A person p1 is supervised by a person p2 by virtue of p1 being directed, managed, or overseen by p2."@en )
@annotation( cco:ont00001754 "http://en.wiktionary.org/wiki/supervise)" )
