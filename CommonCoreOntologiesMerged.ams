Class cco:ont00000766 ;
    ⊑ obo:BFO_0000019.

@annotation( rdfs:comment "A Lubrication System typical consists of a reservoir, pump, heat exchanger, filter, regulator, valves, sensors, pipes, and hoses. In some cases it also includes the passageways and openings within the artifact it is designed to lubricate. For example, the oil holes in a bearing and crankshaft."@en )
@annotation( rdfs:label "Lubrication System"@en )
@annotation( skos:definition "A Material Artifact that is designed to contain, transfer, and regulate the flow of lubricant to multiple locations in an Artifact."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00000767 ;
    ⊑ cco:ont00000995.

@annotation( rdfs:label "Amount"@en )
@annotation( skos:definition "A Quality that inheres in a bearer in virtue of the total, aggregate or sum of a number of discrete items or material the entity contains as parts."@en )
