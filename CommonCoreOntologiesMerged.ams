@annotation( cco:ont00001754 "http://en.wikipedia.org/wiki/Deposit_(bank)" )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class cco:ont00000137 ;
    ⊑ cco:ont00000836.

@annotation( rdfs:label "Maximum Power"@en )
