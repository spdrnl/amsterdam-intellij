Object property cco:ont00001835 ;
    ⊑ cco:ont00001842 ;
    is inverse of cco:ont00001839.

@annotation( rdfs:label "aggregate bearer of"@en )
@annotation( skos:definition "x aggregate_bearer_of y iff x is an instance of Object Aggregate and y is an instance of Specifically Dependent Continuant and z is an instance of Object, such that z bearer of y, and all other members of x are bearers of a unique instance of the same type as y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001836 ;
    has domain obo:BFO_0000027 ;
    has range ( obo:BFO_0000020 ⊔ obo:BFO_0000031 ).

@annotation( rdfs:label "time zone identifier used by"@en )
@annotation( skos:definition "x time_zone_identifier_used_by y iff y is an instance of Information Bearing Entity and x is an instance of Time Zone Identifier, such that x designates the spatial region associated with the time zone mentioned in y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Object property cco:ont00001837 ;
    ⊑ obo:BFO_0000084 ;
    has domain cco:ont00000829 ;
    has range cco:ont00000253 ;
    is inverse of cco:ont00001908.

@annotation( rdfs:label "disconnected with"@en )
@annotation( skos:definition "An immaterial entity im1 is disconnected with some immaterial entity im2 iff there does not exist some immaterial entity im3 that is common to both im1 and im2."@en )
@annotation( skos:scopeNote "Given a stronger temporal interpretation, this property may be symmetric. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI )
Object property cco:ont00001838 ;
    has domain obo:BFO_0000141 ;
    has range obo:BFO_0000141.

@annotation( rdfs:label "has son"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001839 ;
    ⊑ cco:ont00001995.

@annotation( rdfs:label "has grandmother"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001840 ;
    ⊑ cco:ont00001945 ;
    is inverse of cco:ont00001882.

@annotation( rdfs:label "is input of"@en )
@annotation( skos:definition "x is_input_of y iff x is an instance of Continuant and y is an instance of Process, such that the presence of x at the beginning of y is a necessary condition for the start of y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001841 ;
    ⊑ obo:BFO_0000056 ;
    has domain obo:BFO_0000002 ;
    has range obo:BFO_0000015 ;
    is inverse of cco:ont00001921.

@annotation( rdfs:label "is child of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001842 ;
    ⊑ cco:ont00001865 ;
    is inverse of cco:ont00001995.

@annotation( rdfs:comment "Comment is_paternal_first_cousin_of is not a symmetric relationship as is is_first_cousin_of"@en )
@annotation( rdfs:label "is paternal first cousin of"@en )
@annotation( skos:definition "Person A is paternal first cousin of Person B iff Person B has father F and F has sibling P and P is parent of Person A."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001843 ;
    ⊑ cco:ont00001806 ;
    is inverse of cco:ont00001894.

@annotation( rdfs:label "has sender"@en )
@annotation( skos:definition "y has_sender x iff x is an instance of Agent and y is an instance of Act Of Communication, such that x is the initiator and encoder of the InformationContentEntity intended for communication in y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001844 ;
    ⊑ obo:BFO_0000057 ;
    has range cco:ont00001017 ;
    is inverse of cco:ont00001993.

@annotation( rdfs:label "is site of"@en )
@annotation( skos:definition "x is_site_of y iff x is an instance of Site and y is an instance of Process, such that y occurs in x."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001845 ;
    ⊑ obo:BFO_0000183 ;
    has domain obo:BFO_0000029 ;
    has range obo:BFO_0000015 ;
    is inverse of cco:ont00001918.

@annotation( rdfs:label "is organizational context of"@en )
@annotation( skos:definition "x is_organizational_context_of y iff x is an instance of an Organization and y is an instance of a Role and z is an instance of a Person, such that z's affiliation with x is a prerequisite for z bearing y, or x ascribes y to the bearer of y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001846 ;
    has domain cco:ont00001180 ;
    has range obo:BFO_0000023 ;
    is inverse of cco:ont00001992.

@annotation( rdfs:label "interval is after"@en )
@annotation( skos:definition "A TemporalInterval INT2 is after some TemporalInterval INT1 iff there exists TemporalInstants inst2, inst1 such that inst2 is the starting instant of INT2 and inst1 is the ending instant of INT1 and inst2 is after inst1."@en )
@annotation( cco:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI )
Object property cco:ont00001847 ;
    ⊑ cco:ont00001862 ;
    has domain obo:BFO_0000038 ;
    has range obo:BFO_0000038 ;
    is inverse of cco:ont00001940.

@annotation( rdfs:label "is inside instant of"@en )
@annotation( skos:definition "For Temporal Instant t1 and Temporal Interval t2, t1 is inside instant of t2 if and only if there are Temporal Instants t3 and t4 non-identical to t1 and part of t2 such that t3 is before t1 and t4 is after t1."@en )
@annotation( cco:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI )
Object property cco:ont00001848 ;
    has domain obo:BFO_0000148 ;
    has range obo:BFO_0000038.

@annotation( rdfs:label "is father in-law of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001849 ;
    ⊑ cco:ont00001818 ;
    is inverse of cco:ont00001935.

@annotation( rdfs:label "is grandparent of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001850 ;
    ⊑ cco:ont00001865 ;
    is inverse of cco:ont00001945.

@annotation( rdfs:label "is sister of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001851 ;
    ⊑ cco:ont00001902.

@annotation( rdfs:label "accessory in"@en )
@annotation( skos:definition "y is_accessory_in x iff x is an instance of Process and y is an instance of Agent, such that y assists another agent in the commission of x, and y was not located at the location of x when x occurred, and y was not an agent_in x."@en )
@annotation( cco:ont00001754 "http://en.wikipedia.org/wiki/Accessory_(legal_term)" )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001852 ;
    ⊑ obo:BFO_0000056 ;
    has domain obo:BFO_0000040 ;
    has range obo:BFO_0000015 ;
    is inverse of cco:ont00001949.

@annotation( rdfs:label "is mother in-law of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001853 ;
    ⊑ cco:ont00001818 ;
    is inverse of cco:ont00001885.

@annotation( rdfs:label "has daughter in law"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001854 ;
    ⊑ cco:ont00001818 ;
    is inverse of cco:ont00001867.

@annotation( rdfs:label "has spatial part"@en )
@annotation( skos:definition "y has_spatial_part x iff x, y, z, and q are instances of Immaterial Entity, such that for any z connected with x, z is also connected with y, and q is connected with y but not connected with x."@en )
@annotation( cco:ont00001754 "Randell, D. A., Cui, Z. and Cohn, A. G.: 1992, \"A spatial logic based on regions and connection,\" Proc. 3rd Int. Conf. on Knowledge Representation and Reasoning, Morgan Kaufmann, San Mateo, pp. 165-176. Available at: https://www.dpi.inpe.br/gilberto/references/cohn_rcc.pdf"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI )
Object property cco:ont00001855 ;
    ⊑ obo:BFO_0000178 ;
    ⊑ cco:ont00001810 ;
    has domain obo:BFO_0000141 ;
    has range obo:BFO_0000141 ;
    is inverse of cco:ont00001944.

@annotation( rdfs:label "has niece"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001856 ;
    ⊑ cco:ont00001865 ;
    is inverse of cco:ont00001932.

@annotation( rdfs:label "is part of process"@en )
@annotation( skos:definition "x is_part_of_process y iff x and y are instances of Process, such that x occurs during the temporal interval of y, and x either provides an input to y or receives an output of y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001857 ;
    ⊑ obo:BFO_0000132 ;
    has domain obo:BFO_0000015 ;
    has range obo:BFO_0000015.

@annotation( rdfs:label "is daughter of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001858 ;
    ⊑ cco:ont00001842 ;
    is inverse of cco:ont00001987.

@annotation( rdfs:label "is delimited by"@en )
@annotation( skos:definition "An instance of Organization o1 is_delimited_by some Delimiting Domain dd1 iff dd1 is the area within which o1 can legally operate."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Boundary_delimitation&oldid=1039137603"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001859 ;
    has domain cco:ont00001180 ;
    has range cco:ont00001203 ;
    is inverse of cco:ont00001864.

@annotation( rdfs:label "is ancestor of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001860 ;
    ⊑ cco:ont00001865 ;
    is inverse of cco:ont00001968.

@annotation( rdfs:label "is material of"@en )
@annotation( skos:definition "An object m is material of an object o when m is the material of which o consists and that material does not undergo a change of kind during the creation of o"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001861 ;
    has domain obo:BFO_0000030 ;
    has range obo:BFO_0000030 ;
    is inverse of cco:ont00001991.

@annotation( rdfs:label "interval disjoint"@en )
@annotation( skos:definition "A Temporal Interval INT1 is disjoint with a Temporal Interval INT2 iff INT1 is before or meets INT2 OR INT2 is before or meets INT1. In other words, INT1 and INT2 are disjoint iff INT1 and INT2 do not overlap, contain, or equal one another."@en )
@annotation( cco:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI )
Object property cco:ont00001862 ;
    has domain obo:BFO_0000038 ;
    has range obo:BFO_0000038.

@annotation( rdfs:label "uses measurement unit"@en )
@annotation( skos:definition "y uses_measurement_unit x iff y is an instance of Information Bearing Entity and x is an instance of Measurement Unit, such that x describes the magnitude of measured physical quantity mentioned in y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Object property cco:ont00001863 ;
    ⊑ obo:BFO_0000101 ;
    has domain cco:ont00000253 ;
    has range cco:ont00000120 ;
    is inverse of cco:ont00001961.

@annotation( rdfs:label "delimits"@en )
@annotation( skos:definition "An instance of Delimiting Domain dd1 delimits some Organization o1 iff dd1 is the area within which o1 can legally operate."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Boundary_delimitation&oldid=1039137603"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001864 ;
    has domain cco:ont00001203 ;
    has range cco:ont00001180.

@annotation( rdfs:label "has familial relationship to"@en )
@annotation( skos:definition "A relationship between persons by virtue of ancestry or legal union."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001865 ;
    has domain cco:ont00001262 ;
    has range cco:ont00001262 ;
    has characteristics( symmetric ).

@annotation( dcterms:created "2022-12-30T21:32:27-05:00"^^xsd:dateTime )
@annotation( dcterms:creator "https://cubrc.org"^^xsd:anyURI )
@annotation( rdfs:label "is interest of"@en )
@annotation( skos:definition "The inverse of has_interest_in. " )
@annotation( skos:prefLabel "is interest of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001866 ;
    has domain obo:BFO_0000015 ;
    has range cco:ont00001017 ;
    is inverse of cco:ont00001984.

@annotation( rdfs:label "is daughter in-law of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001867 ;
    ⊑ cco:ont00001818.

@annotation( rdfs:label "is a nominal measurement of"@en )
@annotation( skos:definition "x is_a_nominal_measurement_of y iff x is an instance of Information Content Entity and y is an instance of Entity, such that x classifies y relative to some set of shared, possibly arbitrary, characteristics."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Object property cco:ont00001868 ;
    ⊑ cco:ont00001966 ;
    has domain cco:ont00000293 ;
    is inverse of cco:ont00001914.

@annotation( rdfs:label "interval during"@en )
@annotation( skos:definition "A Temporal Interval INT1 is during some Temporal Interval INT2 iff there exist Temporal Instants inst1, inst2, inst3, and inst4 such that inst1 is the starting instant of INT1, inst2 is the ending instant of INT1, inst3 is the starting instant of INT2, inst4 is the ending instant of INT2, inst3 is before inst1, and inst2 is before inst4."@en )
@annotation( cco:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI )
Object property cco:ont00001869 ;
    ⊑ cco:ont00001971 ;
    has domain obo:BFO_0000038 ;
    has range obo:BFO_0000038.

@annotation( rdfs:label "interval overlapped by"@en )
@annotation( skos:definition "A Temporal Interval INT2 is overlapped by some Temporal Interval INT1 iff there exist Temporal Instants inst1, inst2, inst3, inst4 such that inst1 is the starting instant of INT1, inst2 is the ending instant of INT1, inst3 is the starting instant of INT2, inst4 is the ending instant of INT2, inst1 is before inst3, inst3 is before inst2, and inst2 is before inst4."@en )
@annotation( cco:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI )
Object property cco:ont00001870 ;
    has domain obo:BFO_0000038 ;
    has range obo:BFO_0000038.

@annotation( rdfs:label "has wife"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001871 ;
    ⊑ cco:ont00001804 ;
    is inverse of cco:ont00001887.

@annotation( rdfs:label "is step-brother of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001872 ;
    ⊑ cco:ont00001996 ;
    is inverse of cco:ont00001890.

@annotation( rdfs:comment "See notes for inverse property." )
@annotation( rdfs:label "represented by"@en )
@annotation( skos:definition "y represented_by x iff x is an instance of Information Content Entity, and y is an instance of Entity, and z is carrier of x, such that x is about y in virtue of there existing an isomorphism between characteristics of z and y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Object property cco:ont00001873 ;
    ⊑ cco:ont00001801 ;
    has range cco:ont00001069 ;
    is inverse of cco:ont00001938.

@annotation( rdfs:label "is temporal region of"@en )
@annotation( skos:definition "t is temporal region of p iff p occupies temporal region t."@en )
@annotation( skos:editorialNote "Leaving this is in ERO for now since BFO2020 has no inverse of occupies-temporal-region yet."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001874 ;
    has domain obo:BFO_0000008 ;
    has range ( obo:BFO_0000015 ⊔ obo:BFO_0000035 ).

@annotation( rdfs:label "interval started by"@en )
@annotation( skos:definition "A Temporal Interval INT2 is started by some Temporal Interval INT1 iff there exist Temporal Instants inst1, inst2, and inst3 such that inst1 is the starting instant of both INT1 and INT2, inst2 is the ending instant of INT1, inst3 is the ending instant of INT2 and inst2 is before inst3."@en )
@annotation( cco:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI )
Object property cco:ont00001875 ;
    ⊑ cco:ont00001924 ;
    has domain obo:BFO_0000038 ;
    has range obo:BFO_0000038 ;
    is inverse of cco:ont00001923.

@annotation( rdfs:label "is grandfather of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001876 ;
    ⊑ cco:ont00001850.

@annotation( rdfs:label "is a interval measurement of"@en )
@annotation( skos:definition "x is_a_interval_measurement_of y iff x is an instance of Information Content Entity and y is an instance of Entity, such that x describes some attribute of y relative to a scale which has uniform intervals but has a zero value that does not correspond to an absence of the attribute being measured."@en )
@annotation( skos:example "a measurement of air temperature on the Celsius scale." )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Object property cco:ont00001877 ;
    ⊑ cco:ont00001966 ;
    has domain cco:ont00001364 ;
    is inverse of cco:ont00001964.

@annotation( rdfs:label "is mention of"@en )
@annotation( skos:definition "x is_mention_of y iff x is an instance Information Bearing Entity and y is an instance Entity, such that x is used as a reference to y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Object property cco:ont00001878 ;
    is inverse of cco:ont00001919.

@annotation( rdfs:label "designated by"@en )
@annotation( skos:definition "x designated_by y iff y is an instance of Information Content Entity and x is an instance of Entity, such that given some context, y uniquely distinguishes x from other entities."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Object property cco:ont00001879 ;
    ⊑ cco:ont00001801 ;
    has range cco:ont00000686 ;
    is inverse of cco:ont00001916.

@annotation( rdfs:label "capability of aggregate"@en )
@annotation( skos:definition "x capability_of_aggregate y iff y is an instance of Object Aggregate and x is an instance of Agent Capability, such that x inheres in aggregate y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001880 ;
    ⊑ cco:ont00001809 ;
    has domain cco:ont00001379 ;
    has range cco:ont00000300 ;
    is inverse of cco:ont00001898.

@annotation( rdfs:label "is son in-law of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001881 ;
    ⊑ cco:ont00001818.

@annotation( rdfs:label "is grandmother of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001882 ;
    ⊑ cco:ont00001850.

@annotation( rdfs:label "is brother of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001883 ;
    ⊑ cco:ont00001902.

@annotation( rdfs:label "condition described by"@en )
@annotation( skos:definition "c condition_described_by p iff p is an instance of a Performance Specification, and p has part d, and d is an instance of a Descriptive Information Content Entity, and p prescribes an entity s, and d describes c, and c is an entity that is causally relevant to s existing as prescribed by p."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Object property cco:ont00001884 ;
    ⊑ cco:ont00001801 ;
    is inverse of cco:ont00001980.

@annotation( rdfs:label "has mother in law"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001885 ;
    ⊑ cco:ont00001818.

@annotation( rdfs:label "is affected by"@en )
@annotation( skos:definition "x is_affected_by y iff x is an instance of Continuant and y is an instance of Process, and y influences x in some manner, most often by producing a change in x."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001886 ;
    ⊑ obo:BFO_0000056 ;
    has domain obo:BFO_0000002 ;
    has range obo:BFO_0000015.

@annotation( rdfs:label "is wife of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001887 ;
    ⊑ cco:ont00001804.

@annotation( dcterms:created "2022-12-30T21:32:27-05:00"^^xsd:dateTime )
@annotation( dcterms:creator "https://cubrc.org"^^xsd:anyURI )
@annotation( rdfs:label "disrupts"@en )
@annotation( skos:definition "A relation where one process disrupts another process from occurring as it would have."@en )
@annotation( skos:editorialNote "To lower the grade of a process is to lower the quality of a process according to some standard, for example when realizing a capability or a function."@en )
@annotation( skos:prefLabel "disrupts"@en )
@annotation( skos:scopeNote "A process can disrupt another process from occurring as it would have by 1) preventing a disposition or role from being realized by that process, 2) lowering the grade of the process, or 3) stopping the process from continuing to occur."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001888 ;
    has domain obo:BFO_0000015 ;
    has range obo:BFO_0000015.

@annotation( rdfs:label "capability of"@en )
@annotation( skos:definition "x capability_of y iff y is an instance of Agent and x is an instance of Agent Capability, such that x inheres in y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001889 ;
    ⊑ obo:BFO_0000197 ;
    has domain cco:ont00001379 ;
    has range cco:ont00001017 ;
    is inverse of cco:ont00001954.

@annotation( rdfs:label "has step brother"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001890 ;
    ⊑ cco:ont00001996.

@annotation( rdfs:label "has brother in law"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001891 ;
    ⊑ cco:ont00001818 ;
    is inverse of cco:ont00001952.

@annotation( rdfs:label "is paternal grandfather of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001892 ;
    ⊑ cco:ont00001876 ;
    is inverse of cco:ont00001972.

@annotation( rdfs:label "instant is after"@en )
@annotation( skos:definition "A temporal instant t2 (a instance of a zero-dimensional temporal region) is after another temporal instant t1 iff there exists some instance of a temporal interval ti1 such that t1 is the starting instant of ti1 and t2 is the ending instant of ti1."@en )
@annotation( skos:scopeNote "'instant is after' is a primitive relationship. Informally, a temporal instant t2 is after some temporal instant t1 if and only if t1 precedes t2."@en )
@annotation( cco:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI )
Object property cco:ont00001893 ;
    has domain obo:BFO_0000148 ;
    has range obo:BFO_0000148 ;
    is inverse of cco:ont00001990 ;
    has characteristics( transitive ).

@annotation( rdfs:label "has paternal first cousin"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001894 ;
    ⊑ cco:ont00001806.

@annotation( rdfs:label "accomplice in"@en )
@annotation( skos:definition "An agent a1 is accomplice_in some Processual Entity p1 iff a1 assists in the commission of p1, is located at the location of p1, but is not agent_in p1."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Accomplice&oldid=1002047204"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001895 ;
    ⊑ obo:BFO_0000056 ;
    has domain obo:BFO_0000040 ;
    has range obo:BFO_0000015.

@annotation( rdfs:label "interval meets"@en )
@annotation( skos:definition "A Temporal Interval INT1 meets some Temporal Interval INT2 iff there exists some Temporal Instant inst1 such that inst1 is the ending instant of INT1 and inst1 is the starting instant of INT2."@en )
@annotation( cco:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI )
Object property cco:ont00001896 ;
    ⊑ cco:ont00001862 ;
    has domain obo:BFO_0000038 ;
    has range obo:BFO_0000038 ;
    is inverse of cco:ont00001915 ;
    has characteristics( irreflexive ).

@annotation( rdfs:label "is maternal grandmother of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001897 ;
    ⊑ cco:ont00001882 ;
    is inverse of cco:ont00001960.

@annotation( rdfs:label "aggregate has capability"@en )
@annotation( skos:definition "x aggregate_has_capability y iff x is an instance of Object Aggregate and y is an instance of Agent Capability, such that x is aggregate bearer of y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001898 ;
    ⊑ cco:ont00001836 ;
    has domain cco:ont00000300 ;
    has range cco:ont00001379.

@annotation( rdfs:label "language used in"@en )
@annotation( skos:definition "x language_used_by y iff y is an instance of Information Bearing Entity and x is an instance of Language, such that the literal value of y is a string that is encoded according to the syntax of x."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Object property cco:ont00001899 ;
    ⊑ cco:ont00001942 ;
    has domain cco:ont00001175 ;
    has range cco:ont00000253 ;
    is inverse of cco:ont00001976.

@annotation( rdfs:label "is geospatial coordinate reference system of"@en )
@annotation( skos:definition "x is_geospatial_coordinate_reference_system_of y iff y is an instance of Information Bearing Entity and x is an instance of Geospatial Coordinate Reference System, such that x describes the set of standards mentioned in y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Object property cco:ont00001900 ;
    ⊑ cco:ont00001997 ;
    has domain cco:ont00000469 ;
    has range cco:ont00000253 ;
    is inverse of cco:ont00001913.

@annotation( rdfs:label "aggregate has role"@en )
@annotation( skos:definition "x aggregate_has_role y iff x is an instance of Object Aggregate and y is an instance of Role, such that x aggregate_bearer_of y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001901 ;
    ⊑ cco:ont00001836 ;
    has domain obo:BFO_0000027 ;
    has range obo:BFO_0000023.

@annotation( rdfs:label "is sibling of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001902 ;
    ⊑ cco:ont00001865 ;
    is inverse of cco:ont00001902 ;
    has characteristics( symmetric ).

@annotation( rdfs:label "is maternal grandfather of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001903 ;
    ⊑ cco:ont00001876 ;
    is inverse of cco:ont00001973.

@annotation( rdfs:label "is measured by"@en )
@annotation( skos:definition "y is_measured_by x iff x is an instance of Information Content Entity and y is an instance of Entity, such that x describes some attribute of y relative to some scale or classification scheme."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Object property cco:ont00001904 ;
    ⊑ cco:ont00001917 ;
    has range cco:ont00001163 ;
    is inverse of cco:ont00001966.

@annotation( rdfs:label "is half-brother of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001905 ;
    ⊑ cco:ont00001975 ;
    is inverse of cco:ont00001927.

@annotation( rdfs:comment "Comment is_maternal_first_cousin_of is not a symmetric relationship as is is_first_cousin_of"@en )
@annotation( rdfs:label "is maternal first cousin of"@en )
@annotation( skos:definition "Person A is maternal first cousin of Person B iff Person B has mother M and M has sibling P and P is parent of Person A."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001906 ;
    ⊑ cco:ont00001806 ;
    is inverse of cco:ont00001934.

@annotation( rdfs:label "aggregate has quality"@en )
@annotation( skos:definition "x aggregate_has_quality y iff x is an instance of Object Aggregate and y is an instance of Quality, such that x aggregate_bearer_of y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001907 ;
    ⊑ cco:ont00001836 ;
    has domain obo:BFO_0000027 ;
    has range obo:BFO_0000019.

@annotation( rdfs:label "uses time zone identifier"@en )
@annotation( skos:definition "x uses_time_zone_identifier y iff x is an instance of Information Bearing Entity and y is an instance of Time Zone Identifier, such that y designates the spatial region associated with the time zone mentioned in x."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Object property cco:ont00001908 ;
    ⊑ obo:BFO_0000101 ;
    has domain cco:ont00000253 ;
    has range cco:ont00000829.

@annotation( rdfs:label "has tangential part"@en )
@annotation( skos:definition "x has_tangential_part y iff x, y, and z are instances of Immaterial Entity, and x has_spatial_part y, such that z externally connects with both x and y."@en )
@annotation( skos:scopeNote "Given a stronger temporal interpretation, this property may be transitive. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en )
@annotation( cco:ont00001754 "Randell, D. A., Cui, Z. and Cohn, A. G.: 1992, \"A spatial logic based on regions and connection,\" Proc. 3rd Int. Conf. on Knowledge Representation and Reasoning, Morgan Kaufmann, San Mateo, pp. 165-176. Available at: https://www.dpi.inpe.br/gilberto/references/cohn_rcc.pdf"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI )
Object property cco:ont00001909 ;
    ⊑ cco:ont00001855 ;
    has domain obo:BFO_0000141 ;
    has range obo:BFO_0000141.

@annotation( rdfs:label "permits"@en )
@annotation( skos:definition "x permits y at t iff: x is an instance of Process Regulation at time t, and y is an instance of Process at time t, and x prescribes that y may occur."@en )
@annotation( skos:scopeNote "Given a stronger temporal interpretation, this property may be asymmetric and irreflexive. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001910 ;
    ⊑ cco:ont00001942 ;
    has domain cco:ont00001324 ;
    has range obo:BFO_0000015 ;
    is inverse of cco:ont00001998.

@annotation( rdfs:label "is paternal grandmother of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001911 ;
    ⊑ cco:ont00001882 ;
    is inverse of cco:ont00001937.

@annotation( rdfs:label "uses reference system"@en )
@annotation( skos:definition "y uses_reference_system x iff y is an instance of Information Bearing Entity and x is an instance of Reference System, such that x describes the set of standards mentioned in y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Object property cco:ont00001912 ;
    ⊑ obo:BFO_0000101 ;
    has domain cco:ont00000253 ;
    has range cco:ont00000398 ;
    is inverse of cco:ont00001997.

@annotation( rdfs:label "uses geospatial coordinate reference system"@en )
@annotation( skos:definition "y uses_geospatial_coordinate_reference_system x iff y is an instance of Information Bearing Entity and x is an instance of Geospatial Coordinate Reference System, such that x describes the set of standards mentioned in y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Object property cco:ont00001913 ;
    ⊑ cco:ont00001912 ;
    has domain cco:ont00000253 ;
    has range cco:ont00000469.

@annotation( rdfs:label "is measured by nominal"@en )
@annotation( skos:definition "y is_measured_by_nominal x iff x is an instance of Information Content Entity and y is an instance of Entity, such that x classifies y relative to some set of shared, possibly arbitrary, characteristics."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Object property cco:ont00001914 ;
    ⊑ cco:ont00001904 ;
    has range cco:ont00000293.

@annotation( rdfs:label "interval met by"@en )
@annotation( skos:definition "A Temporal Interval INT2 is met by some Temporal Interval INT1 iff there exists some Temporal Instant inst1 such that inst1 is the starting instant of INT2 and inst1 is the ending instant of INT1."@en )
@annotation( cco:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI )
Object property cco:ont00001915 ;
    ⊑ cco:ont00001862 ;
    has domain obo:BFO_0000038 ;
    has range obo:BFO_0000038 ;
    has characteristics( irreflexive ).

@annotation( rdfs:label "designates"@en )
@annotation( skos:definition "x designates y iff x is an instance of an Information Content Entity, and y is an instance of an Entity, such that given some context, x uniquely distinguishes y from other entities."@en )
@annotation( skos:example "a URL designates the location of a Web Page on the internet" )
@annotation( skos:example "a person's name designates that person" )
@annotation( skos:example "a vehicle identification number designates some vehicle" )
@annotation( skos:scopeNote "Given a stronger temporal interpretation, this property may be functional. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Object property cco:ont00001916 ;
    ⊑ cco:ont00001808 ;
    has domain cco:ont00000686.

@annotation( rdfs:label "described by"@en )
@annotation( skos:definition "x described_by y iff y is an instance of Information Content Entity, and x is an instance of Entity, such that y is about the characteristics by which y can be recognized or visualized."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Object property cco:ont00001917 ;
    ⊑ cco:ont00001801 ;
    has range cco:ont00000853 ;
    is inverse of cco:ont00001982.

@annotation( rdfs:label "occurs at"@en )
@annotation( skos:definition "x occurs_at y iff x is an instance of Process and y is an instance of Site, such that x occurs in y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001918 ;
    ⊑ obo:BFO_0000066 ;
    has domain obo:BFO_0000015 ;
    has range obo:BFO_0000029.

@annotation( rdfs:label "prescribed by"@en )
@annotation( skos:definition "x prescribed_by y iff y is an instance of Information Content Entity and x is an instance of Entity, such that y serves as a rule or guide for x if x is an Occurrent, or y serves as a model for x if x is a Continuant."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Object property cco:ont00001920 ;
    ⊑ cco:ont00001801 ;
    has range cco:ont00000965 ;
    is inverse of cco:ont00001942.

@annotation( rdfs:label "has input"@en )
@annotation( skos:definition "y has_input x iff x is an instance of Continuant and y is an instance of Process, such that the presence of x at the beginning of y is a necessary condition for the start of y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001921 ;
    ⊑ obo:BFO_0000057 ;
    has domain obo:BFO_0000015 ;
    has range obo:BFO_0000002.

@annotation( rdfs:label "has recipient"@en )
@annotation( skos:definition "x has_recipient y iff y is an instance of Agent and x is an instance of Act Of Communication, such that y is the recipient and decoder of the InformationContentEntity intended for communication in x."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001922 ;
    ⊑ obo:BFO_0000057 ;
    has range cco:ont00001017 ;
    is inverse of cco:ont00001978.

@annotation( rdfs:label "interval starts"@en )
@annotation( skos:definition "A Temporal Interval INT1 starts some Temporal Interval INT2 iff there exist Temporal Instants inst1, inst2, and inst3 such that inst1 is the starting instant of both INT1 and INT2, inst2 is the ending instant of INT1, inst3 is the ending instant of INT2 and inst2 is before inst3."@en )
@annotation( cco:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI )
Object property cco:ont00001923 ;
    ⊑ cco:ont00001971 ;
    has domain obo:BFO_0000038 ;
    has range obo:BFO_0000038.

@annotation( rdfs:label "interval contains"@en )
@annotation( skos:definition "A Temporal Interval INT2 contains some Temporal Interval INT1 iff there exist Temporal Instants inst1, inst2, inst3, and inst4 such that inst1 is the starting instant of INT1, inst2 is the ending instant of INT1, inst3 is the starting instant of INT2, inst4 is the ending instant of INT2, inst3 is before or identical to inst1, and inst2 is before or identical to inst4, but it is not the case that both inst3 is identical to inst1 and inst2 is identical to inst4."@en )
@annotation( cco:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI )
Object property cco:ont00001924 ;
    has domain obo:BFO_0000038 ;
    has range obo:BFO_0000038 ;
    is inverse of cco:ont00001971.

@annotation( rdfs:label "is paternal uncle of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001926 ;
    ⊑ cco:ont00001988.

@annotation( rdfs:label "has half brother"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001927 ;
    ⊑ cco:ont00001975.

@annotation( rdfs:label "is predecessor of"@en )
@annotation( skos:definition "A continuant c1 is a predecessor of some continuant c2 iff there is some process p1 and c1 is an input to p1 and c2 is an output of p1."@en )
@annotation( skos:scopeNote "More informally, c1 is a predecessor of c2 iff c1 has been followed or replaced by c2."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001928 ;
    has domain obo:BFO_0000004 ;
    has range obo:BFO_0000004.

@annotation( rdfs:label "is maternal uncle of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001929 ;
    ⊑ cco:ont00001988.

@annotation( rdfs:label "is second cousin of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001930 ;
    ⊑ cco:ont00001865 ;
    is inverse of cco:ont00001930 ;
    has characteristics( symmetric ).

@annotation( rdfs:label "externally connects with"@en )
@annotation( skos:definition "An immaterial entity im1 externally connects with some immaterial entity im2 iff im1 connects with im2 and im1 does not overlap with im2."@en )
@annotation( skos:scopeNote "Given a stronger temporal interpretation, this property may be symmetric. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en )
@annotation( cco:ont00001754 "Randell, D. A., Cui, Z. and Cohn, A. G.: 1992, \"A spatial logic based on regions and connection,\" Proc. 3rd Int. Conf. on Knowledge Representation and Reasoning, Morgan Kaufmann, San Mateo, pp. 165-176. Available at: https://www.dpi.inpe.br/gilberto/references/cohn_rcc.pdf"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI )
Object property cco:ont00001931 ;
    ⊑ cco:ont00001810 ;
    has domain obo:BFO_0000141 ;
    has range obo:BFO_0000141.

@annotation( rdfs:label "is niece of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001932 ;
    ⊑ cco:ont00001865.

@annotation( rdfs:label "process starts"@en )
@annotation( skos:definition "x process_starts y iff x and y are instances of processes, and x is_cause_of y, and i is an instance of a temporal instant, and r is an instant of a temporal interval, and y has starting instance i, and x occurs on r, and r interval contains i."@en )
@annotation( skos:scopeNote "A process x starts another process y when x causes y while x is still occurring."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001933 ;
    ⊑ cco:ont00001803 ;
    is inverse of cco:ont00001962.

@annotation( rdfs:label "has maternal first cousin"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001934 ;
    ⊑ cco:ont00001806.

@annotation( rdfs:label "has father in law"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001935 ;
    ⊑ cco:ont00001818.

@annotation( rdfs:label "is object of"@en )
@annotation( skos:definition "If p is a process and c is a continuant, then c is object of p if and only if the c is part of the projected state that the agent intends to achieve by performing p."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001936 ;
    ⊑ obo:BFO_0000056.

@annotation( rdfs:label "has paternal grandmother"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001937 ;
    ⊑ cco:ont00001840.

@annotation( rdfs:comment "Isomorphism between the carrier of x and the represented entity can be via a direct similarity relation, e.g., grooves in a vinyl record corresponding to sound waves, or linguistic convention, e.g., a court stenographer's transcription of spoken words, as well as others, such as encoding processes for images."@en )
@annotation( rdfs:label "represents"@en )
@annotation( skos:definition "x represents y iff x is an instance of Information Content Entity, y is an instance of Entity, and z is carrier of x, such that x is about y in virtue of there existing an isomorphism between characteristics of z and y."@en )
@annotation( skos:scopeNote "Given a stronger temporal interpretation, this property may be functional. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en )
@annotation( skos:scopeNote "The relationship that is being defined here is that between the content of a photographic image and its object, between the content of a video and its objects and events, between the content of an audio recording and the sounds or events generating those sounds, or between the content of a written transcript and the verbal event that it transcribes."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Object property cco:ont00001938 ;
    ⊑ cco:ont00001808 ;
    has domain cco:ont00001069.

@annotation( rdfs:label "is affiliated with"@en )
@annotation( skos:definition "x is_affiliated_with y iff x and y are instances of Agent, such that they have any kind of social or business relationship."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001939 ;
    has domain ( cco:ont00001017 ⊔ cco:ont00001180 ⊔ cco:ont00001262 ) ;
    has range ( cco:ont00001017 ⊔ cco:ont00001180 ⊔ cco:ont00001262 ) ;
    is inverse of cco:ont00001977.

@annotation( rdfs:label "interval is before"@en )
@annotation( skos:definition "A TemporalInterval INT1 is before some TemporalInterval INT2 iff there exists TemporalInstants inst1, inst2 such that inst1 is the ending instant of INT1 and inst2 is the starting instant of INT2 and inst1 is before inst2."@en )
@annotation( cco:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI )
Object property cco:ont00001940 ;
    ⊑ cco:ont00001862 ;
    has domain obo:BFO_0000038 ;
    has range obo:BFO_0000038.

@annotation( rdfs:label "is maternal aunt of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001941 ;
    ⊑ cco:ont00001955 ;
    is inverse of cco:ont00001958.

@annotation( rdfs:label "prescribes"@en )
@annotation( skos:definition "x prescribes y iff x is an instance of Information Content Entity and y is an instance of Entity, such that x serves as a rule or guide for y if y an Occurrent, or x serves as a model for y if y is a Continuant."@en )
@annotation( skos:example "A blueprint prescribes some artifact or facility by being a model for it." )
@annotation( skos:example "A professional code of conduct prescribes some realizations of a profession (role) by giving rules for how the bearer should act in those realizations." )
@annotation( skos:example "An operations plan prescribes an operation by enumerating the tasks that need to be performed in order to achieve the objectives of the operation." )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Object property cco:ont00001942 ;
    ⊑ cco:ont00001808 ;
    has domain cco:ont00000965.

@annotation( rdfs:label "supervises"@en )
@annotation( skos:definition "A person p1 supervises a person p2 by virtue of p1 directing, managing, or overseeing p2."@en )
@annotation( cco:ont00001754 "http://en.wiktionary.org/wiki/supervise" )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001943 ;
    ⊑ cco:ont00001977 ;
    has domain cco:ont00001262 ;
    has range cco:ont00001262.

@annotation( rdfs:comment "in the sense used here, spatial part of is elsewhere referred to as proper spatial part of"@en )
@annotation( rdfs:label "spatial part of"@en )
@annotation( skos:definition "x spatial_part_of y iff x, y, z, and q are instances of Immaterial Entity, such that for any z connected with x, z is also connected with y, and q is connected with y but not connected with x."@en )
@annotation( cco:ont00001754 "Randell, D. A., Cui, Z. and Cohn, A. G.: 1992, \"A spatial logic based on regions and connection,\" Proc. 3rd Int. Conf. on Knowledge Representation and Reasoning, Morgan Kaufmann, San Mateo, pp. 165-176. Available at: https://www.dpi.inpe.br/gilberto/references/cohn_rcc.pdf"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI )
Object property cco:ont00001944 ;
    ⊑ obo:BFO_0000176 ;
    ⊑ cco:ont00001810 ;
    has domain obo:BFO_0000141 ;
    has range obo:BFO_0000141.

@annotation( rdfs:label "is grandchild of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001945 ;
    ⊑ cco:ont00001865.

@annotation( rdfs:label "has father"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001946 ;
    ⊑ cco:ont00001842 ;
    is inverse of cco:ont00001985.

@annotation( rdfs:label "quality of aggregate"@en )
@annotation( skos:definition "x quality_of_aggregate y iff y is an instance of Object Aggregate and x is an instance of Quality, and x inheres_in_aggregate y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001947 ;
    ⊑ cco:ont00001809 ;
    has domain obo:BFO_0000019 ;
    has range obo:BFO_0000027.

@annotation( rdfs:label "is half sister of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001948 ;
    ⊑ cco:ont00001975.

@annotation( rdfs:label "has accessory"@en )
@annotation( skos:definition "x has_accessory y iff x is an instance of Process and y is an instance of Agent, such that y assists another agent in the commission of x, and y was not located at the location of x when x occurred, and y was not an agent_in x."@en )
@annotation( cco:ont00001754 "http://en.wikipedia.org/wiki/Accessory_(legal_term)" )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001949 ;
    ⊑ obo:BFO_0000057 ;
    has domain obo:BFO_0000015 ;
    has range obo:BFO_0000040.

@annotation( rdfs:label "is third cousin of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001950 ;
    ⊑ cco:ont00001865 ;
    is inverse of cco:ont00001950 ;
    has characteristics( symmetric ).

@annotation( rdfs:label "has subordinate role"@en )
@annotation( skos:definition "For all x,y,t: x has subordinate role y at t iff: x is an instance of Role at time t, and y is an instance of Role at time t, and there is some z such that x is realized by z and z is an instance of Process which creates, modifies, transfers, or eliminates some u such that u is a Process Regulation at time t, and u is addressed to the bearer of y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001951 ;
    has domain obo:BFO_0000023 ;
    has range obo:BFO_0000023.

@annotation( rdfs:label "is brother-in-law of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001952 ;
    ⊑ cco:ont00001818.

@annotation( rdfs:label "has parent"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001953 ;
    ⊑ cco:ont00001865 ;
    is inverse of cco:ont00001995.

@annotation( rdfs:label "has capability"@en )
@annotation( skos:definition "x has_capability y iff x is an instance of Agent and y is an instance of Agent Capability, such that x bearer of y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001954 ;
    ⊑ obo:BFO_0000196 ;
    has domain cco:ont00001017 ;
    has range cco:ont00001379.

