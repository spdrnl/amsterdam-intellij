@annotation( rdfs:label "Fuel Cell"@en )
@annotation( skos:definition "An Electrical Power Source that consists in part of an anode, a cathode, and an electrolyte; converts chemical energy from a fuel into electricity through a chemical reaction of positively charged hydrogen ions with an oxidizing agent (typically oxygen); and, if given a continuous source of fuel and oxidizing agent, can continuously produce electricity."@en )
@annotation( skos:scopeNote "A Fuel Cell differs from a Battery in that it requires a continuous source of fuel and oxygen to sustain the chemical reaction, whereas a Battery only uses chemicals already stored inside it."@en )
