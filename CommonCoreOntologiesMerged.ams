@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Wedding&oldid=1063857279"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class cco:ont00000725 ;
