@annotation( rdfs:label "Propulsion Process"@en )
@annotation( skos:definition "A Natural Process in which one or more Forces are generated and applied to a participating Object such that the Object is set in Motion or has the direction or magnitude of its Motion altered."@en )
@annotation( skos:example "a twin-engine turboprop plane rotating both of its propellers against a portion of atmosphere to propel the plane forward" )
@annotation( skos:example "an apple falling to the ground under the power of Earth's gravitational force" )
@annotation( skos:example "burning a portion of fuel to produce exhaust that is ejected through a jet nozzle to propel a rocket and its payload" )
@annotation( skos:example "heat from a fire causing ashes to rise into the sky" )
@annotation( skos:example "launching a water balloon using a sling shot" )
@annotation( skos:example "the wind blowing leaves across a lawn" )
@annotation( skos:example "turning a paddle wheel against a portion of water to propel the paddle boat forward" )
@annotation( skos:scopeNote "In each case, a Propulsion Process minimally involves the Object being propelled, a Reaction Mass (e.g. a portion of water, atmosphere, exhaust, etc.), and the Force(s) acting between these two entities."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class cco:ont00000312 ;
    ⊑ cco:ont00000007.

