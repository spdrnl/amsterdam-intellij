@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00001366 ;
    ⊑ cco:ont00000323.

@annotation( rdfs:comment "Subclasses of one dimensional extent are included for usability. It is doubtful any of them can be objectively distinguished (on the side of the bearing entity) without some reference to external properties such as orientation and perspective."@en )
@annotation( rdfs:label "One Dimensional Extent"@en )
@annotation( skos:definition "A Size Quality that inheres in a bearer in virtue of the bearer's extension in one dimension."@en )
@annotation( cco:ont00001754 "http://purl.obolibrary.org/obo/PATO_0001708" )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI )
Class cco:ont00001367 ;
    ⊑ cco:ont00001202.

@annotation( rdfs:label "Motion Observation Artifact Function"@en )
@annotation( skos:definition "An Observation Artifact Function that is realized during events in which an Artifact is used to collect information about the Motion of a specified object or class of objects."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00001368 ;
    ⊑ cco:ont00001306.

@annotation( rdfs:label "Rectangular"@en )
@annotation( skos:definition "A Shape Quality inhering in a bearer in virtue of having four sides and four 90 degree angles."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI )
Class cco:ont00001369 ;
    ⊑ cco:ont00001059.

@annotation( rdfs:label "Machine Bearing"@en )
@annotation( skos:definition "A Material Artifact that is designed to constrain relative motion to only desired motion and reduces friction between moving parts."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/wiki/Bearing_(mechanical)" )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00001370 ;
    ⊑ cco:ont00000995.

@annotation( rdfs:label "Electromagnetic Induction Artifact Function"@en )
@annotation( skos:definition "An Artifact Function that is realized by processes in which some Artifact that is used to produce electromotive force across an electrical conductor due to its dynamic interaction with a magnetic field."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electromagnetic_induction&oldid=1061836930"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00001371 ;
    ⊑ cco:ont00000323.

@annotation( rdfs:label "Fertilizer Artifact Function"@en )
@annotation( skos:definition "An Enhancing Artifact Function that is realized in processes of supplying soilds or plant tissues with one or more plant nutrients essential to growth."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Fertilizer&oldid=1062923261"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00001372 ;
    ⊑ cco:ont00000437.

@annotation( rdfs:label "Bow"@en )
