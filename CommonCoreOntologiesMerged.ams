@annotation( rdfs:comment "A Julian Year begins concurrently with January 1, ends concurrently with December 31, and has an average duration of exactly 365.25 Julian Days. Julian Years are typically indicated by prefixing a capital 'J' in front of the Year number, e.g. J2000.0 or J2018."@en )
@annotation( rdfs:label "Julian Year"@en )
@annotation( skos:definition "A Calendar Year in the Julian Calendar."@en )
