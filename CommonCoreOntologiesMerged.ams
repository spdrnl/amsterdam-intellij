@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI )
Class cco:ont00000768 ;
    ⊑ obo:BFO_0000019.

@annotation( rdfs:label "Act of Requesting"@en )
