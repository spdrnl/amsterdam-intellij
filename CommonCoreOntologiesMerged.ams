@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00000743 ;
    ⊑ cco:ont00000702.

@annotation( rdfs:label "Act of Social Group Membership"@en )
