@annotation( rdfs:comment "A stand-alone file containing the eleven mid-level Common Core Ontologies plus BFO. Provided for use-cases where one file representing a specific release of CCO and its imports is desirable."@en )
@annotation( rdfs:label "Common Core Ontologies Merged"@en )
@annotation( owl:versionInfo "Depends on http://purl.obolibrary.org/obo/bfo/2020/bfo-core.ttl, obtained 11/03/2024."@en )
@annotation( owl:versionInfo "Version 2.0"@en )
Ontology <https://www.commoncoreontologies.org/CommonCoreOntologiesMerged> versionIRI <https://www.commoncoreontologies.org/2024-11-06/CommonCoreOntologiesMerged>.

@annotation( dc:identifier "001-BFO" )
@annotation( rdfs:label "entity"@en )
@annotation( skos:definition "(Elucidation) An entity is anything that exists or has existed or will exist"@en )
@annotation( skos:example "Julius Caesar; the Second World War; your body mass index; Verdi's Requiem"@en )
Class obo:BFO_0000001.

@annotation( dc:identifier "008-BFO" )
@annotation( rdfs:label "continuant"@en )
@annotation( skos:definition "(Elucidation) A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity"@en )
@annotation( skos:example "A human being; a tennis ball; a cave; a region of space; someone's temperature"@en )
Class obo:BFO_0000002 ;
    ⊑ obo:BFO_0000001 ;
    ⊑ ∀ obo:BFO_0000176 obo:BFO_0000002 ;
    is disjoint with obo:BFO_0000003.

@annotation( dc:identifier "077-BFO" )
@annotation( rdfs:label "occurrent"@en )
@annotation( skos:definition "(Elucidation) An occurrent is an entity that unfolds itself in time or it is the start or end of such an entity or it is a temporal or spatiotemporal region"@en )
@annotation( skos:example "As for process, history, process boundary, spatiotemporal region, zero-dimensional temporal region, one-dimensional temporal region, temporal interval, temporal instant."@en )
Class obo:BFO_0000003 ;
    ⊑ obo:BFO_0000001 ;
    is disjoint with obo:BFO_0000002.

@annotation( dc:identifier "017-BFO" )
@annotation( rdfs:label "independent continuant"@en )
@annotation( skos:definition "b is an independent continuant =Def b is a continuant & there is no c such that b specifically depends on c or b generically depends on c"@en )
@annotation( skos:example "An atom; a molecule; an organism; a heart; a chair; the bottom right portion of a human torso; a leg; the interior of your mouth; a spatial region; an orchestra"@en )
Class obo:BFO_0000004 ;
    ⊑ obo:BFO_0000002 ;
    ⊑ ∀ obo:BFO_0000176 obo:BFO_0000004.

@annotation( dc:identifier "035-BFO" )
@annotation( rdfs:label "spatial region"@en )
@annotation( skos:definition "(Elucidation) A spatial region is a continuant entity that is a continuant part of the spatial projection of a portion of spacetime at a given time"@en )
@annotation( skos:example "As for zero-dimensional spatial region, one-dimensional spatial region, two-dimensional spatial region, three-dimensional spatial region"@en )
Class obo:BFO_0000006 ;
    ⊑ obo:BFO_0000141 ;
    ⊑ ∀ obo:BFO_0000176 obo:BFO_0000006.

@annotation( dc:identifier "100-BFO" )
@annotation( rdfs:label "temporal region"@en )
@annotation( skos:definition "(Elucidation) A temporal region is an occurrent over which processes can unfold"@en )
@annotation( skos:example "As for zero-dimensional temporal region and one-dimensional temporal region"@en )
Class obo:BFO_0000008 ;
    ⊑ obo:BFO_0000003 ;
    ⊑ ∀ obo:BFO_0000132 obo:BFO_0000008 ;
    ⊑ ∀ obo:BFO_0000139 obo:BFO_0000008.

@annotation( dc:identifier "039-BFO" )
@annotation( rdfs:label "two-dimensional spatial region"@en )
@annotation( skos:definition "(Elucidation) A two-dimensional spatial region is a spatial region that is a whole consisting of a surface together with zero or more surfaces which may have spatial regions of lower dimension as parts"@en )
@annotation( skos:example "The surface of a sphere-shaped part of space; an infinitely thin plane in space"@en )
Class obo:BFO_0000009 ;
    ⊑ obo:BFO_0000006 ;
    ⊑ ∀ obo:BFO_0000178 ( obo:BFO_0000009 ⊔ obo:BFO_0000018 ⊔ obo:BFO_0000026 ).

@annotation( dc:identifier "095-BFO" )
@annotation( rdfs:label "spatiotemporal region"@en )
@annotation( skos:definition "(Elucidation) A spatiotemporal region is an occurrent that is an occurrent part of spacetime"@en )
@annotation( skos:example "The spatiotemporal region occupied by the development of a cancer tumour; the spatiotemporal region occupied by an orbiting satellite"@en )
@annotation( skos:scopeNote "'Spacetime' here refers to the maximal instance of the universal spatiotemporal region."@en )
Class obo:BFO_0000011 ;
    ⊑ obo:BFO_0000003 ;
    ⊑ ∀ obo:BFO_0000132 obo:BFO_0000011 ;
    ⊑ ∀ obo:BFO_0000139 obo:BFO_0000011.

@annotation( dc:identifier "083-BFO" )
@annotation( rdfs:label "process"@en )
@annotation( skos:altLabel "event"@en )
@annotation( skos:definition "(Elucidation) p is a process means p is an occurrent that has some temporal proper part and for some time t, p has some material entity as participant"@en )
@annotation( skos:example "An act of selling; the life of an organism; a process of sleeping; a process of cell-division; a beating of the heart; a process of meiosis; the taxiing of an aircraft; the programming of a computer"@en )
Class obo:BFO_0000015 ;
    ⊑ obo:BFO_0000003 ;
    ⊑ ∀ obo:BFO_0000117 ( obo:BFO_0000015 ⊔ obo:BFO_0000035 ) ;
    ⊑ ∀ obo:BFO_0000132 obo:BFO_0000015 ;
    ⊑ ∀ obo:BFO_0000139 obo:BFO_0000015.

@annotation( dc:identifier "062-BFO" )
@annotation( rdfs:label "disposition"@en )
@annotation( skos:altLabel "internally-grounded realizable entity"@en )
@annotation( skos:definition "(Elucidation) A disposition b is a realizable entity such that if b ceases to exist then its bearer is physically changed & b's realization occurs when and because this bearer is in some special physical circumstances & this realization occurs in virtue of the bearer's physical make-up"@en )
@annotation( skos:example "An atom of element X has the disposition to decay to an atom of element Y; the cell wall is disposed to transport cellular material through endocytosis and exocytosis; certain people have a predisposition to colon cancer; children are innately disposed to categorize objects in certain ways"@en )
Class obo:BFO_0000016 ;
    ⊑ obo:BFO_0000017 ;
    is disjoint with obo:BFO_0000023.

@annotation( dc:identifier "058-BFO" )
@annotation( rdfs:label "realizable entity"@en )
@annotation( skos:definition "(Elucidation) A realizable entity is a specifically dependent continuant that inheres in some independent continuant which is not a spatial region & which is of a type some instances of which are realized in processes of a correlated type"@en )
@annotation( skos:example "The role of being a doctor; the role of this boundary to delineate where Utah and Colorado meet; the function of your reproductive organs; the disposition of your blood to coagulate; the disposition of this piece of metal to conduct electricity"@en )
Class obo:BFO_0000017 ;
    ⊑ obo:BFO_0000020 ;
    is disjoint with obo:BFO_0000019.

@annotation( dc:identifier "037-BFO" )
@annotation( rdfs:label "zero-dimensional spatial region"@en )
@annotation( skos:definition "(Elucidation) A zero-dimensional spatial region is one or a collection of more than one spatially disjoint points in space"@en )
@annotation( skos:example "The spatial region occupied at some time instant by the North Pole"@en )
Class obo:BFO_0000018 ;
    ⊑ obo:BFO_0000006 ;
    ⊑ ∀ obo:BFO_0000178 obo:BFO_0000018.

@annotation( dc:identifier "055-BFO" )
@annotation( rdfs:label "quality"@en )
@annotation( skos:definition "(Elucidation) A quality is a specifically dependent continuant that, in contrast to roles and dispositions, does not require any further process in order to be realized"@en )
@annotation( skos:example "The colour of a tomato; the ambient temperature of this portion of air; the length of the circumference of your waist; the shape of your nose; the shape of your nostril; the mass of this piece of gold"@en )
Class obo:BFO_0000019 ;
    ⊑ obo:BFO_0000020 ;
    is disjoint with obo:BFO_0000017.

@annotation( dc:identifier "050-BFO" )
@annotation( rdfs:label "specifically dependent continuant"@en )
@annotation( skos:definition "b is a specifically dependent continuant =Def b is a continuant & there is some independent continuant c which is not a spatial region & which is such that b specifically depends on c"@en )
@annotation( skos:example "(with multiple bearers) John's love for Mary; the ownership relation between John and this statue; the relation of authority between John and his subordinates"@en )
@annotation( skos:example "(with one bearer) The mass of this tomato; the pink colour of a medium rare piece of grilled filet mignon at its centre; the smell of this portion of mozzarella; the disposition of this fish to decay; the role of being a doctor; the function of this heart to pump blood; the shape of this hole"@en )
Class obo:BFO_0000020 ;
    ⊑ obo:BFO_0000002.

@annotation( dc:identifier "061-BFO" )
@annotation( rdfs:label "role"@en )
@annotation( skos:altLabel "externally-grounded realizable entity"@en )
@annotation( skos:definition "(Elucidation) A role b is a realizable entity such that b exists because there is some single bearer that is in some special physical, social, or institutional set of circumstances in which this bearer does not have to be & b is not such that, if it ceases to exist, then the physical make-up of the bearer is thereby changed"@en )
@annotation( skos:example "The priest role; the student role; the role of subject in a clinical trial; the role of a stone in marking a property boundary; the role of a boundary to demarcate two neighbouring administrative territories; the role of a building in serving as a military target"@en )
Class obo:BFO_0000023 ;
    ⊑ obo:BFO_0000017 ;
    is disjoint with obo:BFO_0000016.

@annotation( dc:identifier "027-BFO" )
@annotation( rdfs:label "fiat object part"@en )
@annotation( skos:definition "(Elucidation) A fiat object part b is a material entity & such that if b exists then it is continuant part of some object c & demarcated from the remainder of c by one or more fiat surfaces"@en )
@annotation( skos:example "The upper and lower lobes of the left lung; the dorsal and ventral surfaces of the body; the Western hemisphere of the Earth; the FMA:regional parts of an intact human body"@en )
Class obo:BFO_0000024 ;
    ⊑ obo:BFO_0000040.

@annotation( dc:identifier "038-BFO" )
@annotation( rdfs:label "one-dimensional spatial region"@en )
@annotation( skos:definition "(Elucidation) A one-dimensional spatial region is a whole consisting of a line together with zero or more lines which may have points as parts"@en )
@annotation( skos:example "An edge of a cube-shaped portion of space; a line connecting two points; two parallel lines extended in space"@en )
Class obo:BFO_0000026 ;
    ⊑ obo:BFO_0000006 ;
    ⊑ ∀ obo:BFO_0000178 ( obo:BFO_0000018 ⊔ obo:BFO_0000026 ).

@annotation( dc:identifier "025-BFO" )
@annotation( rdfs:label "object aggregate"@en )
@annotation( skos:definition "(Elucidation) An object aggregate is a material entity consisting exactly of a plurality (≥1) of objects as member parts which together form a unit"@en )
@annotation( skos:example "The aggregate of the musicians in a symphony orchestra and their instruments; the aggregate of bearings in a constant velocity axle joint; the nitrogen atoms in the atmosphere; a collection of cells in a blood biobank"@en )
@annotation( skos:scopeNote "'Exactly' means that there are no parts of the object aggregate other than its member parts." )
@annotation( skos:scopeNote "The unit can, at certain times, consist of exactly one object, for example, when a wolf litter loses all but one of its pups, but it must at some time have a plurality of member parts." )
Class obo:BFO_0000027 ;
    ⊑ obo:BFO_0000040.

@annotation( dc:identifier "040-BFO" )
@annotation( rdfs:label "three-dimensional spatial region"@en )
@annotation( skos:definition "(Elucidation) A three-dimensional spatial region is a whole consisting of a spatial volume together with zero or more spatial volumes which may have spatial regions of lower dimension as parts"@en )
@annotation( skos:example "A cube-shaped region of space; a sphere-shaped region of space; the region of space occupied by all and only the planets in the solar system at some point in time"@en )
Class obo:BFO_0000028 ;
    ⊑ obo:BFO_0000006 ;
    ⊑ ∀ obo:BFO_0000178 obo:BFO_0000006.

@annotation( dc:identifier "034-BFO" )
@annotation( rdfs:label "site"@en )
@annotation( skos:definition "(Elucidation) A site is a three-dimensional immaterial entity whose boundaries either (partially or wholly) coincide with the boundaries of one or more material entities or have locations determined in relation to some material entity"@en )
@annotation( skos:example "A hole in a portion of cheese; a rabbit hole; the Grand Canyon; the Piazza San Marco; the kangaroo-joey-containing hole of a kangaroo pouch; your left nostril (a fiat part - the opening - of your left nasal cavity); the lumen of your gut; the hold of a ship; the interior of the trunk of your car; hole in an engineered floor joist"@en )
Class obo:BFO_0000029 ;
    ⊑ obo:BFO_0000141 ;
    ⊑ ∀ obo:BFO_0000176 ( obo:BFO_0000029 ⊔ obo:BFO_0000040 ) ;
    ⊑ ∀ obo:BFO_0000178 ( obo:BFO_0000029 ⊔ obo:BFO_0000140 ) ;
    ⊑ ∀ obo:BFO_0000210 obo:BFO_0000028.

@annotation( dc:identifier "024-BFO" )
@annotation( rdfs:label "object"@en )
@annotation( skos:definition "(Elucidation) An object is a material entity which manifests causal unity & is of a type instances of which are maximal relative to the sort of causal unity manifested"@en )
@annotation( skos:example "An organism; a fish tank; a planet; a laptop; a valve; a block of marble; an ice cube"@en )
@annotation( skos:scopeNote "A description of three primary sorts of causal unity is provided in Basic Formal Ontology 2.0. Specification and User Guide"@en )
Class obo:BFO_0000030 ;
    ⊑ obo:BFO_0000040.

@annotation( dc:identifier "074-BFO" )
@annotation( rdfs:label "generically dependent continuant"@en )
@annotation( skos:altLabel "g-dependent continuant"@en )
@annotation( skos:definition "(Elucidation) A generically dependent continuant is an entity that exists in virtue of the fact that there is at least one of what may be multiple copies which is the content or the pattern that multiple copies would share"@en )
@annotation( skos:example "The pdf file on your laptop; the pdf file that is a copy thereof on my laptop; the sequence of this protein molecule; the sequence that is a copy thereof in that protein molecule; the content that is shared by a string of dots and dashes written on a page and the transmitted Morse code signal; the content of a sentence; an engineering blueprint"@en )
Class obo:BFO_0000031 ;
    ⊑ obo:BFO_0000002.

@annotation( dc:identifier "064-BFO" )
@annotation( rdfs:label "function"@en )
@annotation( skos:definition "(Elucidation) A function is a disposition that exists in virtue of its bearer's physical make-up & this physical make-up is something the bearer possesses because it came into being either through evolution (in the case of natural biological entities) or through intentional design (in the case of artefacts) in order to realize processes of a certain sort"@en )
@annotation( skos:example "The function of a hammer to drive in nails; the function of a heart pacemaker to regulate the beating of a heart through electricity"@en )
Class obo:BFO_0000034 ;
    ⊑ obo:BFO_0000016.

@annotation( dc:identifier "084-BFO" )
@annotation( rdfs:label "process boundary"@en )
@annotation( skos:definition "p is a process boundary =Def p is a temporal part of a process & p has no proper temporal parts"@en )
@annotation( skos:example "The boundary between the 2nd and 3rd year of your life"@en )
Class obo:BFO_0000035 ;
    ⊑ obo:BFO_0000003 ;
    ⊑ ∀ obo:BFO_0000117 obo:BFO_0000035 ;
    ⊑ ∀ obo:BFO_0000121 obo:BFO_0000035 ;
    ⊑ ∀ obo:BFO_0000132 ( obo:BFO_0000015 ⊔ obo:BFO_0000035 ) ;
    ⊑ ∀ obo:BFO_0000139 ( obo:BFO_0000015 ⊔ obo:BFO_0000035 ).

@annotation( dc:identifier "103-BFO" )
@annotation( rdfs:label "one-dimensional temporal region"@en )
@annotation( skos:definition "(Elucidation) A one-dimensional temporal region is a temporal region that is a whole that has a temporal interval and zero or more temporal intervals and temporal instants as parts"@en )
@annotation( skos:example "The temporal region during which a process occurs"@en )
Class obo:BFO_0000038 ;
    ⊑ obo:BFO_0000008 ;
    ⊑ ∀ obo:BFO_0000121 ( obo:BFO_0000038 ⊔ obo:BFO_0000148 ) ;
    ⊑ ∀ obo:BFO_0000139 obo:BFO_0000038 ;
    is disjoint with obo:BFO_0000148.

@annotation( dc:identifier "019-BFO" )
@annotation( rdfs:label "material entity"@en )
@annotation( skos:definition "(Elucidation) A material entity is an independent continuant has some portion of matter as continuant part"@en )
@annotation( skos:example "A human being; the undetached arm of a human being; an aggregate of human beings"@en )
Class obo:BFO_0000040 ;
    ⊑ obo:BFO_0000004 ;
    ⊑ ∀ obo:BFO_0000176 obo:BFO_0000040 ;
    ⊑ ∀ obo:BFO_0000178 ( obo:BFO_0000029 ⊔ obo:BFO_0000040 ⊔ obo:BFO_0000140 ) ;
    is disjoint with obo:BFO_0000141.

@annotation( dc:identifier "029-BFO" )
@annotation( rdfs:label "continuant fiat boundary"@en )
@annotation( skos:definition "(Elucidation) A continuant fiat boundary b is an immaterial entity that is of zero, one or two dimensions & such that there is no time t when b has a spatial region as continuant part & whose location is determined in relation to some material entity"@en )
@annotation( skos:example "As for fiat point, fiat line, fiat surface"@en )
Class obo:BFO_0000140 ;
    ⊑ obo:BFO_0000141 ;
    ⊑ ∀ obo:BFO_0000124 obo:BFO_0000140 ;
    ⊑ ∀ obo:BFO_0000178 obo:BFO_0000140.

@annotation( dc:identifier "028-BFO" )
@annotation( rdfs:label "immaterial entity"@en )
@annotation( skos:definition "b is an immaterial entity =Def b is an independent continuant which is such that there is no time t when it has a material entity as continuant part"@en )
@annotation( skos:example "As for fiat point, fiat line, fiat surface, site"@en )
Class obo:BFO_0000141 ;
    ⊑ obo:BFO_0000004 ;
    is disjoint with obo:BFO_0000040.

@annotation( dc:identifier "032-BFO" )
@annotation( rdfs:label "fiat line"@en )
@annotation( skos:definition "(Elucidation) A fiat line is a one-dimensional continuant fiat boundary that is continuous"@en )
@annotation( skos:example "The Equator; all geopolitical boundaries; all lines of latitude and longitude; the median sulcus of your tongue; the line separating the outer surface of the mucosa of the lower lip from the outer surface of the skin of the chin"@en )
Class obo:BFO_0000142 ;
    ⊑ obo:BFO_0000140 ;
    ⊑ ∀ obo:BFO_0000178 ( obo:BFO_0000142 ⊔ obo:BFO_0000147 ).

@annotation( rdfs:label "Process Profile"@en )
@annotation( skos:definition "An occurrent that is an occurrent part of some process by virtue of the rate, or pattern, or amplitude of change in an attribute of one or more participants of said process."@en )
@annotation( skos:example "On a somewhat higher level of complexity are what we shall call rate process profiles, which are the targets of selective abstraction focused not on determinate quality magnitudes plotted over time, but rather on certain ratios between these magnitudes and elapsed times. A speed process profile, for example, is represented by a graph plotting against time the ratio of distance covered per unit of time. Since rates may change, and since such changes, too, may have rates of change, we have to deal here with a hierarchy of process profile universals at successive levels; One important sub-family of rate process profiles is illustrated by the beat or frequency profiles of cyclical processes, illustrated by the 60 beats per minute beating process of John’s heart, or the 120 beats per minute drumming process involved in one of John’s performances in a rock band, and so on. Each such process includes what we shall call a beat process profile instance as part, a subtype of rate process profile in which the salient ratio is not distance covered but rather number of beat cycles per unit of time. Each beat process profile instance instantiates the determinable universal beat process profile. But it also instantiates multiple more specialized universals at lower levels of generality, selected from rate process profilebeat process profileregular beat process profile3 bpm beat process profile4 bpm beat process profileirregular beat process profileincreasing beat process profileand so on.In the case of a regular beat process profile, a rate can be assigned in the simplest possible fashion by dividing the number of cycles by the length of the temporal region occupied by the beating process profile as a whole. Irregular process profiles of this sort, for example as identified in the clinic, or in the readings on an aircraft instrument panel, are often of diagnostic significance.; The simplest type of process profiles are what we shall call ‘quality process profiles’, which are the process profiles which serve as the foci of the sort of selective abstraction that is involved when measurements are made of changes in single qualities, as illustrated, for example, by process profiles of mass, temperature, aortic pressure, and so on."@en )
@annotation( skos:scopeNote "b process_profile_of c holds when b proper_occurrent_part_of c& there is some proper_occurrent_part d of c which has no parts in common with b & is mutually dependent on b& is such that b, c and d occupy the same temporal region (axiom label in BFO2 Reference: [094-005])"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class obo:BFO_0000144 ;
    ⊑ obo:BFO_0000003.

@annotation( dc:identifier "057-BFO" )
@annotation( rdfs:label "relational quality"@en )
@annotation( skos:definition "b is a relational quality =Def b is a quality & there exists c and d such that c and d are not identical & b specifically depends on c & b specifically depends on d"@en )
@annotation( skos:example "A marriage bond; an instance of love; an obligation between one person and another"@en )
Class obo:BFO_0000145 ;
    ⊑ obo:BFO_0000019.

@annotation( dc:identifier "033-BFO" )
@annotation( rdfs:label "fiat surface"@en )
@annotation( skos:definition "(Elucidation) A fiat surface is a two-dimensional continuant fiat boundary that is self-connected"@en )
@annotation( skos:example "The surface of the Earth; the plane separating the smoking from the non-smoking zone in a restaurant"@en )
Class obo:BFO_0000146 ;
    ⊑ obo:BFO_0000140 ;
    ⊑ ∀ obo:BFO_0000178 obo:BFO_0000140.

@annotation( dc:identifier "031-BFO" )
@annotation( rdfs:label "fiat point"@en )
@annotation( skos:definition "(Elucidation) A fiat point is a zero-dimensional continuant fiat boundary that consists of a single point"@en )
@annotation( skos:example "The geographic North Pole; the quadripoint where the boundaries of Colorado, Utah, New Mexico and Arizona meet; the point of origin of some spatial coordinate system"@en )
Class obo:BFO_0000147 ;
    ⊑ obo:BFO_0000140 ;
    ⊑ ∀ obo:BFO_0000178 obo:BFO_0000147.

@annotation( dc:identifier "102-BFO" )
@annotation( rdfs:label "zero-dimensional temporal region"@en )
@annotation( skos:definition "(Elucidation) A zero-dimensional temporal region is a temporal region that is a whole consisting of one or more separated temporal instants as parts"@en )
@annotation( skos:example "A temporal region that is occupied by a process boundary; the moment at which a finger is detached in an industrial accident"@en )
Class obo:BFO_0000148 ;
    ⊑ obo:BFO_0000008 ;
    ⊑ ∀ obo:BFO_0000121 obo:BFO_0000148 ;
    is disjoint with obo:BFO_0000038.

@annotation( dc:identifier "138-BFO" )
@annotation( rdfs:label "history"@en )
@annotation( skos:definition "(Elucidation) A history is a process that is the sum of the totality of processes taking place in the spatiotemporal region occupied by the material part of a material entity"@en )
@annotation( skos:example "The life of an organism from the beginning to the end of its existence"@en )
Class obo:BFO_0000182 ;
    ⊑ obo:BFO_0000015.

@annotation( dc:identifier "155-BFO" )
@annotation( rdfs:label "temporal interval"@en )
@annotation( skos:definition "(Elucidation) A temporal interval is a one-dimensional temporal region that is continuous, thus without gaps or breaks"@en )
@annotation( skos:example "The year 2018."@en )
@annotation( skos:scopeNote "A one-dimensional temporal region can include as parts not only temporal intervals but also temporal instants separated from other parts by gaps."@en )
Class obo:BFO_0000202 ;
    ⊑ obo:BFO_0000038.

@annotation( dc:identifier "209-BFO" )
@annotation( rdfs:label "temporal instant"@en )
@annotation( skos:definition "(Elucidation) A temporal instant is a zero-dimensional temporal region that has no proper temporal part"@en )
@annotation( skos:example "The millennium"@en )
Class obo:BFO_0000203 ;
    ⊑ obo:BFO_0000148.

@annotation( rdfs:label "Deflecting Prism"@en )
@annotation( skos:definition "A Prism designed to deflect a beam of light entering the Prism by a fixed angle."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00000001 ;
    ⊑ cco:ont00000804.

@annotation( rdfs:label "Cooling Artifact Function"@en )
@annotation( skos:definition "An Artifact Function that is realized in a process in which the thermal energy of a system decreases."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00000002 ;
    ⊑ cco:ont00000323.

@annotation( rdfs:label "Designative Name"@en )
@annotation( skos:altLabel "Name"@en )
@annotation( skos:definition "A Designative Information Content Entity that consists of a string of characters that designates an entity within a specified cultural or social namespace and which is typically a word or phrase in a natural language that has an accepted cultural or social significance."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Class cco:ont00000003 ;
    ⊑ cco:ont00000686 ;
    is disjoint with cco:ont00000649.

@annotation( rdfs:label "Change"@en )
@annotation( skos:definition "A Process in which some independent continuant endures and 1) one or more of the dependent entities it bears increase or decrease in intensity, 2) the entity begins to bear some dependent entity or 3) the entity ceases to bear some dependent entity."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class cco:ont00000004 ;
    ⊑ obo:BFO_0000015.

@annotation( rdfs:label "Act"@en )
@annotation( skos:definition "A Process in which at least one Agent plays a causative role."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class cco:ont00000005 ;
    ⊑ obo:BFO_0000015.

@annotation( rdfs:label "Upper Midrange Frequency"@en )
@annotation( skos:definition "A Sonic Frequency that is between 2 and 4 kHz."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class cco:ont00000006 ;
    ⊑ cco:ont00000530.

@annotation( rdfs:label "Natural Process"@en )
@annotation( skos:definition "A Process existing in or produced by nature; rather than by the intent of human beings."@en )
@annotation( cco:ont00001754 "http://www.thefreedictionary.com/natural+process" )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class cco:ont00000007 ;
    ⊑ obo:BFO_0000015.

@annotation( rdfs:label "Sound Frequency"@en )
@annotation( skos:definition "A Frequency that is the rate of Oscillations per second of a Sound Wave."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class cco:ont00000008 ;
    ⊑ cco:ont00001047.

@annotation( rdfs:label "Mass Density"@en )
@annotation( skos:altLabel "Density"@en )
@annotation( skos:definition "A Quality that inheres in a bearer in virtue of that bearer's mass per unit volume."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI )
Class cco:ont00000009 ;
    ⊑ obo:BFO_0000019.

@annotation( rdfs:label "Incorporated Organization"@en )
@annotation( skos:altLabel "Corporation"@en )
@annotation( skos:definition "An Organization formed by an Act of Incorporation that consists of an association of individuals, created by law or under authority of law, having a continuous existence independent of the existences of its members and owners, and having powers and liabilities distinct from those of its members and owners."@en )
@annotation( cco:ont00001754 "http://www.dictionary.com/browse/corporation" )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Class cco:ont00000010 ;
    ⊑ cco:ont00001180.

@annotation( rdfs:label "Nominal Stasis"@en )
@annotation( skos:altLabel "Nominal"@en )
@annotation( skos:definition "A Stasis of Specifically Dependent Continuant in which some Independent Continuant bears a Quality or Realizable Entity that has a level of intensity or functionality that falls within the designed, expected, or acceptable range such that the Independent Continuant is of normal value, usefulness, or functionality."@en )
@annotation( cco:ont00001754 "https://en.oxforddictionaries.com/definition/nominal (Definition 6)" )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class cco:ont00000011 ;
    ⊑ cco:ont00000135.

@annotation( rdfs:label "Propulsion Control System"@en )
@annotation( skos:definition "A Control System that consists of control devices, displays, indicators, or modules designed to control a Propulsion System."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00000012 ;
    ⊑ cco:ont00000781.

@annotation( rdfs:label "Gain of Generically Dependent Continuant"@en )
@annotation( skos:definition "A Gain of Dependent Continuant wherein some Independent Continuant becomes the carrier of some Generically Dependent Continuant."@en )
@annotation( skos:example "A Person forms a Plan, A Person is initiated into a Religion, A photgraphic image is produced." )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class cco:ont00000013 ;
    ⊑ cco:ont00000554 ;
    ⊑ ∃ obo:BFO_0000057 ( obo:BFO_0000004 ⊓ ∃ obo:BFO_0000101 obo:BFO_0000031 ).

@annotation( rdfs:label "Aztec Code"@en )
@annotation( skos:definition "A Two-Dimensional Barcode that is used by the transportation industry to scan tickets."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00000014 ;
    ⊑ cco:ont00000241.

@annotation( rdfs:label "Shotgun"@en )
@annotation( skos:definition "A Long Gun that fires packets of shot, a single slug, a sabot, or a specialty round (such as tear gas, bolo shell, or a breaching round) over shorter ranges than that of Rifles and with less accuracy."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Shotgun&oldid=1062571691"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00000015 ;
    ⊑ cco:ont00001104.

@annotation( rdfs:label "Triangular Waveform"@en )
@annotation( skos:definition "A Waveform that is characterized by a triangular shape due to the continuous linear zig-zag transitions between minimum and maximum Amplitudes of the Wave Cycle."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class cco:ont00000016 ;
    ⊑ cco:ont00001286.

@annotation( rdfs:label "Minor Axis"@en )
@annotation( skos:definition "A One-Dimensional Spatial Region that is the longest line segment perpendicular to the Major Axis that connects two points on the edge of an Ellipse."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Semi-major_and_semi-minor_axes&oldid=1047911304"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI )
Class cco:ont00000017 ;
    ⊑ obo:BFO_0000026.

@annotation( rdfs:label "Title Document"@en )
@annotation( skos:definition "A Legal Instrument that is designed as evidence of ownership."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/wiki/Title_(property)" )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00000018 ;
    ⊑ cco:ont00001346.

@annotation( rdfs:label "Power Inverting Artifact Function"@en )
@annotation( skos:definition "A Current Conversion Artifact Function that is realized by processes in which some Artifact is used to convert direct current (DC) to alternating current (AC)."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00000019 ;
    ⊑ cco:ont00000961.

@annotation( rdfs:label "Container"@en )
@annotation( skos:definition "A Material Artifact that is designed to contain (wholly or partially) some material entity."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00000020 ;
    ⊑ cco:ont00000995.

@annotation( rdfs:label "Sensor Platform"@en )
@annotation( skos:definition "A Material Artifact that is designed to support, and in some cases transport, a Sensor during its deployment and functioning."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00000021 ;
    ⊑ cco:ont00000995.

@annotation( rdfs:label "Radio Communication Reception Artifact Function"@en )
@annotation( skos:definition "A Communication Reception Artifact Function that is realized during events in which an Artifact receives information transmitted from another Artifact, where the transmission of information occurs using radio waves."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00000022 ;
    ⊑ cco:ont00000422.

@annotation( rdfs:label "Sensor Deployment Artifact Function"@en )
@annotation( skos:definition "An Artifact Function that inheres in Artifacts that are designed to support or convey one or more Sensors while the Sensors are realizing their own Artifact Functions."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00000023 ;
    ⊑ cco:ont00000323.

@annotation( rdfs:label "Act of Advising"@en )
@annotation( skos:definition "An Act of Directive Communication performed by providing advice or counsel to another agent."@en )
@annotation( cco:ont00001754 "http://www.dictionary.com/browse/advising" )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class cco:ont00000024 ;
    ⊑ cco:ont00000133.

@annotation( rdfs:label "Electronic Stock"@en )
@annotation( skos:definition "Stock that consists of Bytes."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00000025 ;
    ⊑ cco:ont00001278.

@annotation( rdfs:label "Hair Color"@en )
@annotation( skos:definition "A Quality inhering in a portion of Hair by virtue of its color."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Class cco:ont00000026 ;
    ⊑ obo:BFO_0000019.

@annotation( rdfs:label "Mailing"@en )
@annotation( skos:altLabel "Act of Mailing"@en )
@annotation( skos:definition "An Act of Communication by Media in which information and tangible objects, usually written documents, are delivered to destinations around the world."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Mail&oldid=1057401839"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class cco:ont00000027 ;
    ⊑ cco:ont00000517.

@annotation( rdfs:label "Dispersive Prism"@en )
@annotation( skos:definition "A Prism designed to break up a beam of light entering the Prism into its constituent spectral colors by leveraging the refractive index of light based on its Frequency."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00000028 ;
    ⊑ cco:ont00000804.

@annotation( rdfs:label "Median Point Estimate Information Content Entity"@en )
@annotation( skos:altLabel "Median"@en )
@annotation( skos:definition "A Point Estimate Information Content Entity that is a measurement of a set of values and is equal to either the middle value or the average of the two values which separate the set into two equally populated upper and lower sets."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Class cco:ont00000029 ;
    ⊑ cco:ont00000745.

@annotation( rdfs:label "Nuclear Reactor"@en )
@annotation( skos:definition "A Power Source that is designed to initiate and control a self-sustained nuclear chain reaction to produce power in the form of heat, which can be transferred to a working fluid for further conversion to mechanical or electrical energy."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Nuclear_reactor&oldid=1063370273"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00000030 ;
    ⊑ cco:ont00000288.

@annotation( rdfs:label "Atmospheric Feature"@en )
@annotation( skos:definition "A Geographic Feature that is part of the atmosphere (including the atmosphere itself as a non-proper part) having a relatively stable lifecycle and which has a location that can be distinguished from the surrounding portion of the atmosphere."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI )
Class cco:ont00000031 ;
    ⊑ cco:ont00001081.

@annotation( rdfs:label "Church"@en )
@annotation( skos:definition "A Religious Facility that is designed for Christian worship and prayer."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/wiki/Church_(building)" )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI )
Class cco:ont00000032 ;
    ⊑ cco:ont00000052.

@annotation( rdfs:label "Decrease of Role"@en )
@annotation( skos:definition "A Decrease of Realizable Entity in which some Independent Continuant has a decrease of some Role that it bears."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class cco:ont00000033 ;
    ⊑ cco:ont00000854.

@annotation( rdfs:label "Conveyance Artifact Function"@en )
@annotation( skos:definition "A Motion Artifact Function that is realized in a process in which the bearer of the function conveys entities from one location to another."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Vehicle&oldid=1063682179"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00000034 ;
    ⊑ cco:ont00000448.

@annotation( rdfs:label "Soft X-ray Frequency"@en )
@annotation( skos:definition "An X-Ray Frequency that is between 30 petahertz and 3 exahertz."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class cco:ont00000035 ;
    ⊑ cco:ont00000490.

@annotation( rdfs:label "Waste Management Artifact Function"@en )
@annotation( skos:definition "A Service Artifact Function that is realized in processes of collecting transporting processing recycling or disposing and monitoring of waste materials."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Waste_management&oldid=1062844209"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00000036 ;
    ⊑ cco:ont00001301.

@annotation( rdfs:label "Act of Observation"@en )
@annotation( skos:definition "A Planned Act of acquiring information from a source via the use of one or more senses."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Observation&oldid=1062502087"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class cco:ont00000037 ;
    ⊑ cco:ont00000228.

@annotation( rdfs:label "System Role"@en )
@annotation( skos:definition "A Role that inheres in an entity in virtue of its parts or elements being arranged in such a way that they together exhibit behavior or meaning that they do not exhibit individually."@en )
@annotation( cco:ont00001754 "https://www.incose.org/about-systems-engineering/system-and-se-definition/general-system-definition"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00000038 ;
    ⊑ obo:BFO_0000023.

@annotation( rdfs:label "Portion of Solid Fuel"@en )
@annotation( skos:definition "A Portion of Fuel that is stored in a solid state."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00000039 ;
    ⊑ cco:ont00000838.

@annotation( rdfs:label "Grocery Store"@en )
