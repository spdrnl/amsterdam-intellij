Annotation property dc:contributor.

Annotation property dc:identifier.

Annotation property dc:license.

Annotation property dcterms:bibliographicCitation.

Annotation property dcterms:contributor.

Annotation property dcterms:created.

Annotation property dcterms:creator.

Annotation property dcterms:description.

Annotation property dcterms:license.

Annotation property dcterms:rights.

Annotation property dcterms:title.

Annotation property skos:altLabel.

Annotation property skos:definition.

Annotation property skos:editorialNote.

Annotation property skos:example.

Annotation property skos:prefLabel.

Annotation property skos:scopeNote.

@annotation( rdfs:label "query text"@en )
@annotation( skos:definition "The text of a query that is associated with a class"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Annotation property cco:ont00001735.

@annotation( rdfs:label "doctrinal definition"@en )
@annotation( skos:definition "A Definition that is taken directly from a Doctrinal Source."@en )
@annotation( skos:scopeNote "There is only one definition for any given term in an ontology; however, a Doctrinal Definition may be provided in addition to the asserted Definition if the preservation of this information is important. When both a Definition and a Doctrinal Definition are provided for a term, the Definition takes precedence."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Annotation property cco:ont00001737 ;
    ⊑ skos:definition.

@annotation( rdfs:label "SI unit label"@en )
@annotation( skos:definition "An Alternative Label that is officially accepted for use in the International System of Units (SI) as denoting a Measurement Unit."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI )
Annotation property cco:ont00001738 ;
    ⊑ skos:altLabel.

@annotation( rdfs:label "ordinal measurement annotation"@en )
@annotation( skos:definition "An ordinal measurement value of an instance of a quality, realizable or process profile"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Annotation property cco:ont00001739 ;
    ⊑ cco:ont00001746.

@annotation( rdfs:label "SI unit symbol"@en )
@annotation( skos:definition "An Acronym that is officially accepted for use in the International System of Units (SI) as denoting a Measurement Unit."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI )
Annotation property cco:ont00001740 ;
    ⊑ cco:ont00001753.

@annotation( rdfs:label "nominal measurement annotation"@en )
@annotation( skos:definition "A nominal measurement value of an instance of a quality, realizable or process profile"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Annotation property cco:ont00001741 ;
    ⊑ cco:ont00001746.

@annotation( rdfs:label "term creator"@en )
@annotation( skos:definition "The name of the Term Editor who added the term to the ontology."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Annotation property cco:ont00001742 ;
    ⊑ cco:ont00001762.

@annotation( rdfs:label "content license"@en )
@annotation( skos:definition "The name and description of the license under which the ideas, concepts and other informational content expressed in the .owl file are released."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Annotation property cco:ont00001743.

@annotation( rdfs:label "copyright"@en )
@annotation( skos:definition "An assertion of copyright"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Annotation property cco:ont00001744.

@annotation( rdfs:label "doctrinal source"@en )
@annotation( skos:definition "A Definition Source that consists of a formalized doctrine in which the term is authoritatively defined."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Annotation property cco:ont00001745 ;
    ⊑ cco:ont00001754.

@annotation( rdfs:label "measurement annotation"@en )
@annotation( skos:definition "A measurement value of an instance of a quality, realizable or process profile"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Annotation property cco:ont00001746.

@annotation( rdfs:label "ratio measurement annotation"@en )
@annotation( skos:definition "A ratio measurement value of an instance of a quality, realizable or process profile"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Annotation property cco:ont00001747 ;
    ⊑ cco:ont00001746.

@annotation( rdfs:label "doctrinal label"@en )
@annotation( skos:definition "An Alternative Label that consists of the preferred term or phrase used by a Doctrinal Source to denote the entity."@en )
@annotation( skos:scopeNote "When the cco:doctrinal_label is identical to the rdfs:label, the cco:doctrinal_label annotation is superfluous. As a subclass of 'alternative label', 'doctrinal label' is intended to be used to provide additional information about the entity when its preferred doctrinal designator is ambiguous or otherwise inappropriate for use as the rdfs:label."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Annotation property cco:ont00001748 ;
    ⊑ skos:altLabel.

@annotation( rdfs:label "doctrinal acronym"@en )
@annotation( skos:definition "An Acronym that is used by a Doctrinal Source to denote the entity."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Annotation property cco:ont00001749 ;
    ⊑ cco:ont00001753.

@annotation( rdfs:label "has token unit"@en )
@annotation( skos:definition "A relation between an information content entity and a widely used measurement unit of the token used to express it."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Annotation property cco:ont00001752.

@annotation( rdfs:label "acronym"@en )
@annotation( skos:definition "An Alternative Label that consists of a shortened or abbreviated form of the rdfs:label and is used to denote the entity."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Annotation property cco:ont00001753 ;
    ⊑ skos:altLabel.

@annotation( rdfs:label "definition source"@en )
@annotation( skos:definition "A citation of where all or some of the information used to create the term's Definition was acquired from."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Annotation property cco:ont00001754.

@annotation( rdfs:label "interval measurement annotation"@en )
@annotation( skos:definition "A interval measurement value of an instance of a quality, realizable or process profile "@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Annotation property cco:ont00001756 ;
    ⊑ cco:ont00001746.

@annotation( rdfs:label "designator annotation"@en )
@annotation( skos:definition "A name or other identifier that is used to designate an individual."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Annotation property cco:ont00001757.

@annotation( rdfs:label "http query string"@en )
@annotation( skos:definition "The text of an HTTP request that can be sent to a SPARQL Protocol service."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Annotation property cco:ont00001758.

@annotation( rdfs:label "code license"@en )
@annotation( skos:definition "The name and description of the license under which the .owl file is released."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Annotation property cco:ont00001759.

@annotation( rdfs:label "is curated in ontology"@en )
@annotation( skos:definition "An annotation property that links a class, property, or named individual to the URI of the ontology where it is located."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Annotation property cco:ont00001760.

@annotation( rdfs:label "is tokenized by"@en )
@annotation( skos:definition "A relation between an information content entity and a widely used token used to express it."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Annotation property cco:ont00001761.

@annotation( rdfs:label "term editor"@en )
@annotation( skos:definition "The name of a person who contributed to the development or enhancement of the term."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Annotation property cco:ont00001762.

@annotation( dcterms:license "BSD 3-Clause: https://github.com/CommonCoreOntology/CommonCoreOntologies/blob/master/LICENSE"@en )
