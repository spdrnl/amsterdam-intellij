@annotation( rdfs:comment "The submillimeter waveband is between the far-infrared and microwave wavebands and is typically taken to have a wavelength of between a few hundred micrometers and a millimeter."@en )
@annotation( rdfs:label "Submillimeter Wavelength Radio Telescope"@en )
@annotation( skos:altLabel "Microwave Telescope"@en )
@annotation( skos:definition "A Radio Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing radio waves from the submillimeter waveband (i.e. microwaves) to form an enhanced image of the Object."@en )
@annotation( cco:ont00001754 "http://kp12m.as.arizona.edu/docs/what_is_submillimeter.htm, https://en.wikipedia.org/wiki/Submillimetre_astronomy" )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00000728 ;
    ⊑ cco:ont00000215.

@annotation( rdfs:label "Spherical Coordinate System"@en )
@annotation( skos:definition "A Spatial Reference System for three-dimensional spatial regions that identifies each point using an ordered triple of numerical coordinates that consist of the radial distance of the point of interest from a fixed origin, its polar angle measured from a fixed zenith direction, and the azimuth angle of its orthogonal projection measured from a fixed direction on a reference plane that passes through the origin and is orthogonal to the zenith."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Spherical_coordinate_system&oldid=1061029174"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Class cco:ont00000729 ;
    ⊑ cco:ont00000275.

@annotation( rdfs:label "Hydraulic Power Transfer Unit"@en )
@annotation( skos:definition "A Material Artifact that is designed to transfer hydraulic power from one of an Aircraft's hydraulic systems to another in the event that a system has failed or been turned off."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Power_transfer_unit&oldid=1002682083"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00000730 ;
    ⊑ cco:ont00000995.

@annotation( rdfs:comment "'Deviation Measurement Information Content Entity' and 'Veracity Measurement Information Content Entity' are complementary notions. Deviation is a measure of whether reality conforms to an ICE (e.g., a plan or prediction), whereas Veracity is a measure of whether a Descriptive ICE conforms to reality."@en )
@annotation( rdfs:comment "Note, the term 'accuracy' is avoided due to its ambiguity between: correctness-of-performance (see: 'Reliability Measurement Information Content Entity'), correctness-of-information (see: 'Veracity Measurement Information Content Entity'), and adherance-to-expectations ('Deviation Measurement Information Content Entity')."@en )
@annotation( rdfs:label "Deviation Measurement Information Content Entity"@en )
@annotation( skos:altLabel "Conformance Measurement"@en )
@annotation( skos:altLabel "Degree of Conformance"@en )
@annotation( skos:altLabel "Degree of Deviation"@en )
@annotation( skos:altLabel "Deviation Measurement"@en )
@annotation( skos:definition "A Measurement Information Content Entity that is a measurement of the extent to which an entity conforms to how it is expected or supposed to be."@en )
@annotation( skos:example "a missile impact deviates from its target location by 100 feet" )
@annotation( skos:example "a satellite deviaties from its predicted orbital path by 5 kilometers" )
@annotation( skos:example "an overweight piece of luggage deviates from an airline's maximum allowed weight by +10 pounds" )
@annotation( skos:scopeNote "In order for a Deviation to exist, an entity must first be expected, represented, prescribed, or predicted as being a certain way. Then, at a future time, this value can be compared to its actual, reported, or measured value to determine the Deviation between these values."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Class cco:ont00000731 ;
    ⊑ cco:ont00001163.

@annotation( rdfs:comment "The corresponding Wavelength range is 1,000–1 mm"@en )
@annotation( rdfs:label "Microwave Frequency"@en )
@annotation( skos:definition "A Radio Frequency that is between 300 MHz and 300 GHz."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Microwave&oldid=1062124842"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class cco:ont00000732 ;
    ⊑ cco:ont00000150.

@annotation( rdfs:label "Spherical"@en )
