@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class cco:ont00000138 ;
    ⊑ cco:ont00000503.

@annotation( dcterms:bibliographicCitation "Convention on Rights and Duties of States (inter-American); December 26, 1933. https://avalon.law.yale.edu/20th_century/intam03.asp. Accessed 6 Apr. 2023." )
@annotation( dcterms:creator "https://cubrc.org"^^xsd:anyURI )
@annotation( rdfs:label "Domain of a Country"@en )
@annotation( skos:definition "A Government Domain that is associated with certain distinct political, ethnic, or cultural characteristics, and which delimits a Government that has legitimate authority over a Populace."@en )
@annotation( skos:editorialNote "'Country' is an unclear term. Does it refer to the people, the government, the site, or the material in the site? Furthermore, what is properly referred to as a 'Country' is highly dependent on the classification practices of the international community. For example: The United Kingdom is a sovereign country that has Wales, a non-sovereign Country, as a member. Vatican City is a sovereign country that is landlocked by a city: Rome, Italy. Puerto Rico is not a country (it's a territory) but has a government, a distinct culture, and so on. Thus, here we do not define 'Country' but instead define 'Domain of a Country'."@en )
@annotation( skos:prefLabel "Domain of a Country"@en )
@annotation( cco:ont00001754 "https://avalon.law.yale.edu/20th_century/intam03.asp" )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Class cco:ont00000139 ;
    ⊑ cco:ont00001152.

@annotation( rdfs:comment "The type of particle quantified is typically either atoms or molecules, but may also be protons, neutrons, electrons, quarks, or other particles. The type of particle being measured should always be specified along with the measurement and its unit."@en )
@annotation( rdfs:label "Measurement Unit of Amount of Substance"@en )
@annotation( skos:altLabel "Measurement Unit of Chemical Amount"@en )
@annotation( skos:altLabel "Measurement Unit of Enplethy"@en )
@annotation( skos:definition "A Measurement Unit that is used as a standard for measurement of the number of a specified type of particle in a portion of matter."@en )
@annotation( skos:example "mole, pound-mole" )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology" )
Class cco:ont00000140 ;
    ⊑ cco:ont00000120.

@annotation( rdfs:label "Populace"@en )
