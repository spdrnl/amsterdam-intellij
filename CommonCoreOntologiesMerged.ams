@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001828 ;
    ⊑ cco:ont00001818.

@annotation( rdfs:label "disposition of aggregate"@en )
@annotation( skos:definition "x disposition_of_aggregate y iff y is an instance of Object Aggregate and x is an instance of Disposition, and x inheres_in_aggregate y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001829 ;
    ⊑ cco:ont00001809 ;
