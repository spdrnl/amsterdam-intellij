@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00001373 ;
    ⊑ cco:ont00001051.

@annotation( rdfs:comment "Examples: Baptism, Sentencing a person to imprisonment, Pronouncing a couple husband and wife, Declaring war"@en )
@annotation( rdfs:label "Act of Declarative Communication"@en )
@annotation( skos:definition "An Act of Communication that changes the reality in accord with the proposition of the declaration."@en )
@annotation( cco:ont00001754 "Derived (loosely) from: John Searle's Speech Acts: An Essay in the Philosophy of Language" )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class cco:ont00001374 ;
    ⊑ cco:ont00000402.

@annotation( rdfs:label "Washing Facility"@en )
@annotation( skos:definition "A Facility that is designed to wash personnel or equipment."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Washing&oldid=1035998791"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI )
Class cco:ont00001375 ;
    ⊑ cco:ont00000192.

@annotation( rdfs:label "Torque"@en )
@annotation( skos:altLabel "Moment of Force"@en )
@annotation( skos:definition "A Force that is applied to an object in a direction that would tend to cause the object to rotate around an Axis of Rotation and is the rate of change of an object's Angular Momentum."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Torque&oldid=1063339484"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class cco:ont00001376 ;
    ⊑ cco:ont00000570.

@annotation( rdfs:label "Gold Color"@en )
@annotation( skos:definition "A Color that resembles a yellow-orange Hue with the added feature of having a metallic shine."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI )
Class cco:ont00001377 ;
    ⊑ cco:ont00000378.

@annotation( rdfs:label "Hospitality Artifact Function"@en )
@annotation( skos:definition "A Service Artifact Function that is realized in processes of accommodation food and beverage meeting and events gaming entertainment and recreation tourism services and visitor information."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Hospitality&oldid=1049599161"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00001378 ;
    ⊑ cco:ont00001301.

@annotation( rdfs:label "Agent Capability"@en )
@annotation( skos:definition "A Realizable Entity that inheres in a Material Entity in virtue of that Material Entity's capacity to realize it in some Planned Act."@en )
@annotation( cco:ont00001754 "Schlosser, Markus, \"Agency\", The Stanford Encyclopedia of Philosophy (Winter 2019 Edition), Edward N. Zalta (ed.), available at: https://plato.stanford.edu/archives/win2019/entries/agency/"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Class cco:ont00001379 ;
    ⊑ obo:BFO_0000017.

@annotation( rdfs:label "Farm"@en )
@annotation( skos:definition "An Agricultural Facility that is designed to produce food and other crops."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Farm&oldid=1058311769"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI )
Class cco:ont00001380 ;
    ⊑ cco:ont00000339.

@annotation( rdfs:label "Medical Artifact"@en )
@annotation( skos:definition "A Material Artifact that is designed for diagnosing, treating, or preventing disease, disability, or death."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00001381 ;
    ⊑ cco:ont00000995.

@annotation( rdfs:label "Electronic Cash"@en )
@annotation( skos:definition "A Portion of Cash that consists of Bytes."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00001382 ;
    ⊑ cco:ont00000475.

@annotation( rdfs:label "Fire Station"@en )
@annotation( skos:altLabel "Fire Hall"@en )
@annotation( skos:altLabel "Fire House"@en )
@annotation( skos:definition "A Public Safety Facility that is designed for the storage of firefighting apparatus."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Fire_station&oldid=1060666629"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI )
Class cco:ont00001383 ;
    ⊑ cco:ont00000479.

@annotation( rdfs:comment "Note that it is important to specify the frequency of electromagnetic radiation when representing a bearer's Opacity since a bearer may be Opaque with respect to electromagnetic radiation of one frequency, but be transparent with respect to electromagnetic radiation of another frequency. Unless otherwise stated, statements about a bearer's Opacity are assumed to be about electromagnetic radiation with a frequency in the visible spectrum."@en )
@annotation( rdfs:label "Opacity"@en )
@annotation( skos:definition "An Electromagnetic Radiation Property that inheres in a bearer in virtue of that bearer's capacity to transmit electromagnetic radiation of a given frequency through the bearer instead of reflecting, scattering, or absorbing electromangentic radiation of that frequency."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/wiki/Opacity_(optics)" )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI )
Class cco:ont00001384 ;
    ⊑ cco:ont00000628.

@annotation( rdfs:comment """Although its basic function remains the same, a Filter can be used in 2 different ways:
(1) to allow only the desired entities to pass through (e.g. removing dirt from engine oil); or
(2) to allow everything except the desired entities to pass through (e.g. panning for gold)."""@en )
@annotation( rdfs:label "Filter Function"@en )
@annotation( skos:definition "An Artifact Function that is realized in a process where entities of a specific type or which have specified properties enter it or pass through it."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00001999 ;
    ⊑ cco:ont00000323.

AllDisjointClasses( obo:BFO_0000004, obo:BFO_0000020, obo:BFO_0000031 ).

AllDisjointClasses( obo:BFO_0000006, obo:BFO_0000029, obo:BFO_0000140 ).

AllDisjointClasses( obo:BFO_0000008, obo:BFO_0000011, obo:BFO_0000015, obo:BFO_0000035 ).

AllDisjointClasses( obo:BFO_0000009, obo:BFO_0000018, obo:BFO_0000026, obo:BFO_0000028 ).

AllDisjointClasses( obo:BFO_0000142, obo:BFO_0000146, obo:BFO_0000147 ).

@annotation( dc:identifier "206-BFO" )
@annotation( rdfs:label "has realization"@en )
@annotation( skos:altLabel "realized in"@en )
@annotation( skos:definition "b has realization c =Def c realizes b"@en )
@annotation( skos:example "As for realizes"@en )
Object property obo:BFO_0000054 ;
    has domain obo:BFO_0000017 ;
    has range obo:BFO_0000015 ;
    is inverse of obo:BFO_0000055.

@annotation( dc:identifier "059-BFO" )
@annotation( rdfs:label "realizes"@en )
@annotation( skos:definition "(Elucidation) realizes is a relation between a process b and realizable entity c such that c inheres in some d & for all t, if b has participant d then c exists & the type instantiated by b is correlated with the type instantiated by c"@en )
@annotation( skos:example "A balding process realizes a disposition to go bald; a studying process realizes a student role; a process of pumping blood realizes the pumping function of a heart"@en )
Object property obo:BFO_0000055 ;
    has domain obo:BFO_0000015 ;
    has range obo:BFO_0000017.

@annotation( dc:identifier "250-BFO" )
@annotation( rdfs:label "participates in"@en )
@annotation( skos:definition "(Elucidation) participates in holds between some b that is either a specifically dependent continuant or generically dependent continuant or independent continuant that is not a spatial region & some process p such that b participates in p some way"@en )
@annotation( skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en )
Object property obo:BFO_0000056 ;
    has domain ( obo:BFO_0000020 ⊔ obo:BFO_0000031 ⊔ ( obo:BFO_0000004 ⊓ ¬ obo:BFO_0000006 ) ) ;
    has range obo:BFO_0000015 ;
    is inverse of obo:BFO_0000057.

@annotation( dc:identifier "248-BFO" )
@annotation( rdfs:label "has participant"@en )
@annotation( skos:definition "p has participant c =Def c participates in p"@en )
@annotation( skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en )
Object property obo:BFO_0000057 ;
    has domain obo:BFO_0000015 ;
    has range ( obo:BFO_0000020 ⊔ obo:BFO_0000031 ⊔ ( obo:BFO_0000004 ⊓ ¬ obo:BFO_0000006 ) ).

@annotation( dc:identifier "258-BFO" )
@annotation( rdfs:label "is concretized by"@en )
@annotation( skos:definition "c is concretized by b =Def b concretizes c"@en )
@annotation( skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en )
Object property obo:BFO_0000058 ;
    has domain obo:BFO_0000031 ;
    has range ( obo:BFO_0000015 ⊔ obo:BFO_0000020 ) ;
    is inverse of obo:BFO_0000059.

@annotation( dc:identifier "256-BFO" )
@annotation( rdfs:label "concretizes"@en )
@annotation( skos:definition "b concretizes c =Def b is a process or a specifically dependent continuant & c is a generically dependent continuant & there is some time t such that c is the pattern or content which b shares at t with actual or potential copies"@en )
@annotation( skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en )
Object property obo:BFO_0000059 ;
    has domain ( obo:BFO_0000015 ⊔ obo:BFO_0000020 ) ;
    has range obo:BFO_0000031.

@annotation( dc:identifier "213-BFO" )
@annotation( rdfs:label "preceded by"@en )
@annotation( skos:definition "b preceded by c =Def b precedes c"@en )
@annotation( skos:example "The temporal region occupied by the second half of the match is preceded by the temporal region occupied by the first half of the match"@en )
Object property obo:BFO_0000062 ;
    has domain obo:BFO_0000003 ;
    has range obo:BFO_0000003 ;
    is inverse of obo:BFO_0000063 ;
    has characteristics( transitive ).

@annotation( dc:identifier "270-BFO" )
@annotation( rdfs:label "precedes"@en )
@annotation( skos:definition "(Elucidation) precedes is a relation between occurrents o, o' such that if t is the temporal extent of o & t' is the temporal extent of o' then either the last instant of o is before the first instant of o' or the last instant of o is the first instant of o' & neither o nor o' are temporal instants"@en )
@annotation( skos:example "The temporal region occupied by Mary's birth precedes the temporal region occupied by Mary's death."@en )
@annotation( skos:scopeNote "Each temporal region is its own temporal extent. The temporal extent of a spatiotemporal region is the temporal region it temporally projects onto. The temporal extent of a process or process boundary that occupies temporal region t is t." )
@annotation( skos:scopeNote "Precedes defines a strict partial order on occurrents." )
Object property obo:BFO_0000063 ;
    has domain obo:BFO_0000003 ;
    has range obo:BFO_0000003 ;
    has characteristics( transitive ).

@annotation( dc:identifier "143-BFO" )
@annotation( rdfs:label "occurs in"@en )
@annotation( skos:definition "b occurs in c =Def b is a process or a process boundary & c is a material entity or site & there exists a spatiotemporal region r & b occupies spatiotemporal region r & for all time t, if b exists at t then c exists at t & there exist spatial regions s and s' where b spatially projects onto s at t & c occupies spatial region s' at t & s is a continuant part of s' at t"@en )
@annotation( skos:example "A process of digestion occurs in the interior of an organism; a process of loading artillery rounds into a tank cannon occurs in the interior of the tank"@en )
Object property obo:BFO_0000066 ;
    has domain ( obo:BFO_0000015 ⊔ obo:BFO_0000035 ) ;
    has range ( obo:BFO_0000029 ⊔ obo:BFO_0000040 ) ;
    is inverse of obo:BFO_0000183.

@annotation( dc:identifier "252-BFO" )
@annotation( rdfs:label "generically depends on"@en )
@annotation( skos:altLabel "g-depends on"@en )
@annotation( skos:definition "b generically depends on c =Def b is a generically dependent continuant & c is an independent continuant that is not a spatial region & at some time t there inheres in c a specifically dependent continuant which concretizes b at t"@en )
@annotation( skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en )
Object property obo:BFO_0000084 ;
    has domain obo:BFO_0000031 ;
    has range ( obo:BFO_0000004 ⊓ ¬ obo:BFO_0000006 ) ;
    is inverse of obo:BFO_0000101.

@annotation( dc:identifier "254-BFO" )
@annotation( rdfs:label "is carrier of"@en )
@annotation( skos:definition "b is carrier of c =Def there is some time t such that c generically depends on b at t"@en )
@annotation( skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en )
Object property obo:BFO_0000101 ;
    has domain ( obo:BFO_0000004 ⊓ ¬ obo:BFO_0000006 ) ;
    has range obo:BFO_0000031.

@annotation( dc:identifier "118-BFO" )
@annotation( rdfs:label "exists at"@en )
@annotation( skos:definition "(Elucidation) exists at is a relation between a particular and some temporal region at which the particular exists"@en )
@annotation( skos:example "First World War exists at 1914-1916; Mexico exists at January 1, 2000"@en )
Object property obo:BFO_0000108 ;
    has domain obo:BFO_0000001 ;
    has range obo:BFO_0000008.

@annotation( dc:identifier "230-BFO" )
@annotation( rdfs:label "has member part"@en )
@annotation( skos:definition "b has member part c =Def c member part of b"@en )
@annotation( skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en )
Object property obo:BFO_0000115 ;
    ⊑ obo:BFO_0000178 ;
    has domain obo:BFO_0000040 ;
    has range obo:BFO_0000040 ;
    is inverse of obo:BFO_0000129.

@annotation( dc:identifier "202-BFO" )
@annotation( rdfs:label "has occurrent part"@en )
@annotation( skos:definition "b has occurrent part c =Def c occurrent part of b"@en )
@annotation( skos:example "Mary's life has occurrent part Mary's 5th birthday"@en )
Object property obo:BFO_0000117 ;
    has domain obo:BFO_0000003 ;
    has range obo:BFO_0000003 ;
    is inverse of obo:BFO_0000132 ;
    has characteristics( transitive ).

@annotation( dc:identifier "211-BFO" )
@annotation( rdfs:label "has temporal part"@en )
@annotation( skos:definition "b has temporal part c =Def c temporal part of b"@en )
@annotation( skos:example "Your life has temporal part the first year of your life"@en )
Object property obo:BFO_0000121 ;
    ⊑ obo:BFO_0000117 ;
    has domain obo:BFO_0000003 ;
    has range obo:BFO_0000003 ;
    is inverse of obo:BFO_0000139 ;
    has characteristics( transitive ).

@annotation( dc:identifier "236-BFO" )
@annotation( rdfs:label "location of"@en )
@annotation( skos:definition "b location of c =Def c located in b"@en )
@annotation( skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en )
Object property obo:BFO_0000124 ;
    has domain ( obo:BFO_0000004 ⊓ ¬ obo:BFO_0000006 ) ;
    has range ( obo:BFO_0000004 ⊓ ¬ obo:BFO_0000006 ) ;
    is inverse of obo:BFO_0000171.

@annotation( dc:identifier "244-BFO" )
@annotation( rdfs:label "material basis of"@en )
@annotation( skos:definition "b material basis of c =Def c has material basis b"@en )
@annotation( skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en )
Object property obo:BFO_0000127 ;
    has domain obo:BFO_0000040 ;
    has range obo:BFO_0000016 ;
    is inverse of obo:BFO_0000218.

@annotation( dc:identifier "228-BFO" )
@annotation( rdfs:label "member part of"@en )
@annotation( skos:definition "b member part of c =Def b is an object & c is a material entity & there is some time t such that b continuant part of c at t & there is a mutually exhaustive and pairwise disjoint partition of c into objects x1, ..., xn (for some n ≠ 1) with b = xi (for some 1 <= i <= n)"@en )
@annotation( skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en )
Object property obo:BFO_0000129 ;
    ⊑ obo:BFO_0000176 ;
    has domain obo:BFO_0000040 ;
    has range obo:BFO_0000040.

@annotation( dc:identifier "003-BFO" )
@annotation( rdfs:label "occurrent part of"@en )
@annotation( skos:definition "(Elucidation) occurrent part of is a relation between occurrents b and c when b is part of c"@en )
@annotation( skos:example "Mary's 5th birthday is an occurrent part of Mary's life; the first set of the tennis match is an occurrent part of the tennis match"@en )
Object property obo:BFO_0000132 ;
    has domain obo:BFO_0000003 ;
    has range obo:BFO_0000003 ;
    has characteristics( transitive ).

@annotation( dc:identifier "078-BFO" )
@annotation( rdfs:label "temporal part of"@en )
@annotation( skos:definition "b temporal part of c =Def b occurrent part of c & (b and c are temporal regions) or (b and c are spatiotemporal regions & b temporally projects onto an occurrent part of the temporal region that c temporally projects onto) or (b and c are processes or process boundaries & b occupies a temporal region that is an occurrent part of the temporal region that c occupies)"@en )
@annotation( skos:example "Your heart beating from 4pm to 5pm today is a temporal part of the process of your heart beating; the 4th year of your life is a temporal part of your life, as is the process boundary which separates the 3rd and 4th years of your life; the first quarter of a game of football is a temporal part of the whole game"@en )
Object property obo:BFO_0000139 ;
    ⊑ obo:BFO_0000132 ;
    has domain obo:BFO_0000003 ;
    has range obo:BFO_0000003 ;
    has characteristics( transitive ).

@annotation( dc:identifier "080-BFO" )
@annotation( rdfs:label "temporally projects onto"@en )
@annotation( skos:definition "(Elucidation) temporally projects onto is a relation between a spatiotemporal region s and some temporal region which is the temporal extent of s"@en )
@annotation( skos:example "The world line of a particle temporally projects onto the temporal region extending from the beginning to the end of the existence of the particle"@en )
Object property obo:BFO_0000153 ;
    has domain obo:BFO_0000011 ;
    has range obo:BFO_0000008 ;
    has characteristics( functional ).

@annotation( dc:identifier "234-BFO" )
@annotation( rdfs:label "located in"@en )
@annotation( skos:definition "b located in c =Def b is an independent continuant & c is an independent & neither is a spatial region & there is some time t such that the spatial region which b occupies at t is continuant part of the spatial region which c occupies at t"@en )
@annotation( skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en )
Object property obo:BFO_0000171 ;
    has domain ( obo:BFO_0000004 ⊓ ¬ obo:BFO_0000006 ) ;
    has range ( obo:BFO_0000004 ⊓ ¬ obo:BFO_0000006 ).

@annotation( dc:identifier "221-BFO" )
@annotation( rdfs:label "continuant part of"@en )
@annotation( skos:definition "b continuant part of c =Def b and c are continuants & there is some time t such that b and c exist at t & b continuant part of c at t"@en )
@annotation( skos:example "Milk teeth continuant part of human; surgically removed tumour continuant part of organism"@en )
@annotation( skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en )
Object property obo:BFO_0000176 ;
    has domain obo:BFO_0000002 ;
    has range obo:BFO_0000002 ;
    is inverse of obo:BFO_0000178.

@annotation( dc:identifier "271-BFO" )
@annotation( rdfs:label "has continuant part"@en )
@annotation( skos:definition "b has continuant part c =Def c continuant part of b"@en )
@annotation( skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en )
Object property obo:BFO_0000178 ;
    has domain obo:BFO_0000002 ;
    has range obo:BFO_0000002.

@annotation( dc:identifier "267-BFO" )
@annotation( rdfs:label "environs"@en )
@annotation( skos:altLabel "contains process"@en )
@annotation( skos:definition "b environs c =Def c occurs in b"@en )
@annotation( skos:example "Mouth environs process of mastication; city environs traffic"@en )
Object property obo:BFO_0000183 ;
    has domain ( obo:BFO_0000029 ⊔ obo:BFO_0000040 ) ;
    has range ( obo:BFO_0000015 ⊔ obo:BFO_0000035 ).

@annotation( dc:identifier "144-BFO" )
@annotation( rdfs:label "history of"@en )
@annotation( skos:definition "(Elucidation) history of is a relation between history b and material entity c such that b is the unique history of c"@en )
@annotation( skos:example "This life is the history of this organism"@en )
Object property obo:BFO_0000184 ;
    has domain obo:BFO_0000182 ;
    has range obo:BFO_0000040 ;
    is inverse of obo:BFO_0000185 ;
    has characteristics( functional, inverseFunctional ).

@annotation( dc:identifier "145-BFO" )
@annotation( rdfs:label "has history"@en )
@annotation( skos:definition "b has history c =Def c history of b"@en )
@annotation( skos:example "This organism has history this life"@en )
Object property obo:BFO_0000185 ;
    has domain obo:BFO_0000040 ;
    has range obo:BFO_0000182.

@annotation( dc:identifier "260-BFO" )
@annotation( rdfs:label "specifically depended on by"@en )
@annotation( skos:altLabel "s-depended on by"@en )
@annotation( skos:definition "b specifically depended on by c =Def c specifically depends on b"@en )
@annotation( skos:example "Coloured object specifically depended on by colour"@en )
Object property obo:BFO_0000194 ;
    has domain ( obo:BFO_0000020 ⊔ ( obo:BFO_0000004 ⊓ ¬ obo:BFO_0000006 ) ) ;
    has range obo:BFO_0000020 ;
    is inverse of obo:BFO_0000195.

@annotation( dc:identifier "012-BFO" )
@annotation( rdfs:label "specifically depends on"@en )
@annotation( skos:altLabel "s-depends on"@en )
@annotation( skos:definition "(Elucidation) specifically depends on is a relation between a specifically dependent continuant b and specifically dependent continuant or independent continuant that is not a spatial region c such that b and c share no parts in common & b is of a nature such that at all times t it cannot exist unless c exists & b is not a boundary of c"@en )
@annotation( skos:example "A shape specifically depends on the shaped object; hue, saturation and brightness of a colour sample specifically depends on each other"@en )
@annotation( skos:scopeNote "The analogue of specifically depends on for occurrents is has participant."@en )
Object property obo:BFO_0000195 ;
    has domain obo:BFO_0000020 ;
    has range ( obo:BFO_0000020 ⊔ ( obo:BFO_0000004 ⊓ ¬ obo:BFO_0000006 ) ).

@annotation( dc:identifier "053-BFO" )
@annotation( rdfs:label "bearer of"@en )
@annotation( skos:definition "b bearer of c =Def c inheres in b"@en )
@annotation( skos:example "A patch of ink is the bearer of a colour quality; an organism is the bearer of a temperature quality"@en )
Object property obo:BFO_0000196 ;
    ⊑ obo:BFO_0000194 ;
    has domain ( obo:BFO_0000004 ⊓ ¬ obo:BFO_0000006 ) ;
    has range obo:BFO_0000020 ;
    is inverse of obo:BFO_0000197.

@annotation( dc:identifier "051-BFO" )
@annotation( rdfs:label "inheres in"@en )
@annotation( skos:definition "b inheres in c =Def b is a specifically dependent continuant & c is an independent continuant that is not a spatial region & b specifically depends on c"@en )
@annotation( skos:example "A shape inheres in a shaped object; a mass inheres in a material entity"@en )
Object property obo:BFO_0000197 ;
    ⊑ obo:BFO_0000195 ;
    has domain obo:BFO_0000020 ;
    has range ( obo:BFO_0000004 ⊓ ¬ obo:BFO_0000006 ).

@annotation( dc:identifier "132-BFO" )
@annotation( rdfs:label "occupies temporal region"@en )
@annotation( skos:definition "p occupies temporal region t =Def p is a process or process boundary & the spatiotemporal region occupied by p temporally projects onto t"@en )
@annotation( skos:example "The Second World War occupies the temporal region September 1, 1939 - September 2, 1945"@en )
Object property obo:BFO_0000199 ;
    has domain ( obo:BFO_0000015 ⊔ obo:BFO_0000035 ) ;
    has range obo:BFO_0000008 ;
    is inverse of cco:ont00001874 ;
    has characteristics( functional ).

@annotation( dc:identifier "082-BFO" )
@annotation( rdfs:label "occupies spatiotemporal region"@en )
@annotation( skos:definition "(Elucidation) occupies spatiotemporal region is a relation between a process or process boundary p and the spatiotemporal region s which is its spatiotemporal extent"@en )
@annotation( skos:example "A particle emitted by a nuclear reactor occupies the spatiotemporal region which is its trajectory"@en )
Object property obo:BFO_0000200 ;
    has domain ( obo:BFO_0000015 ⊔ obo:BFO_0000035 ) ;
    has range obo:BFO_0000011 ;
    has characteristics( functional ).

@annotation( dc:identifier "232-BFO" )
@annotation( rdfs:label "occupies spatial region"@en )
@annotation( skos:definition "b occupies spatial region r =Def b is an independent continuant that is not a spatial region & r is a spatial region & there is some time t such that every continuant part of b occupies some continuant part of r at t and no continuant part of b occupies any spatial region that is not a continuant part of r at t"@en )
@annotation( skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en )
Object property obo:BFO_0000210 ;
    has domain ( obo:BFO_0000004 ⊓ ¬ obo:BFO_0000006 ) ;
    has range obo:BFO_0000006.

@annotation( dc:identifier "246-BFO" )
@annotation( rdfs:label "spatially projects onto"@en )
@annotation( skos:definition "(Elucidation) spatially projects onto is a relation between some spatiotemporal region b and spatial region c such that at some time t, c is the spatial extent of b at t"@en )
@annotation( skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en )
Object property obo:BFO_0000216 ;
    has domain obo:BFO_0000011 ;
    has range obo:BFO_0000006.

@annotation( dc:identifier "242-BFO" )
@annotation( rdfs:label "has material basis"@en )
@annotation( skos:definition "b has material basis c =Def b is a disposition & c is a material entity & there is some d bearer of b & there is some time t such that c is a continuant part of d at t & d has disposition b because c is a continuant part of d at t"@en )
@annotation( skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en )
Object property obo:BFO_0000218 ;
    has domain obo:BFO_0000016 ;
    has range obo:BFO_0000040.

@annotation( dc:identifier "268-BFO" )
@annotation( rdfs:label "first instant of"@en )
@annotation( skos:definition "t first instant of t' =Def t is a temporal instant & t' is a temporal region t' & t precedes all temporal parts of t' other than t"@en )
@annotation( skos:example "An hour starting at midnight yesterday has first instant midnight yesterday"@en )
Object property obo:BFO_0000221 ;
    has domain obo:BFO_0000203 ;
    has range obo:BFO_0000008 ;
    is inverse of obo:BFO_0000222.

@annotation( dc:identifier "261-BFO" )
@annotation( rdfs:label "has first instant"@en )
@annotation( skos:definition "t has first instant t' =Def t' first instant of t"@en )
@annotation( skos:example "The first hour of a year has first instant midnight on December 31"@en )
Object property obo:BFO_0000222 ;
    has domain obo:BFO_0000008 ;
    has range obo:BFO_0000203 ;
    has characteristics( functional ).

@annotation( dc:identifier "269-BFO" )
@annotation( rdfs:label "last instant of"@en )
@annotation( skos:definition "t last instant of t' =Def t is a temporal instant & t' is a temporal region & all temporal parts of t' other than t precede t"@en )
@annotation( skos:example "Last midnight is the last instant of yesterday"@en )
Object property obo:BFO_0000223 ;
    has domain obo:BFO_0000203 ;
    has range obo:BFO_0000008 ;
    is inverse of obo:BFO_0000224.

@annotation( dc:identifier "215-BFO" )
@annotation( rdfs:label "has last instant"@en )
@annotation( skos:definition "t has last instant t' =Def t' last instant of t"@en )
@annotation( skos:example "The last hour of a year has last instant midnight December 31"@en )
Object property obo:BFO_0000224 ;
    has domain obo:BFO_0000008 ;
    has range obo:BFO_0000203 ;
    has characteristics( functional ).

@annotation( rdfs:label "has brother"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001774 ;
    ⊑ cco:ont00001902 ;
    is inverse of cco:ont00001883.

@annotation( rdfs:label "is successor of"@en )
@annotation( skos:definition "A continuant c2 is a successor of some continuant c1 iff there is some process p1 and c1 is an input to p1 and c2 is an output of p1. Inverse of is predecessor. "@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001775 ;
    has domain obo:BFO_0000004 ;
    has range obo:BFO_0000004 ;
    is inverse of cco:ont00001928.

@annotation( rdfs:label "has grandfather"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001776 ;
    ⊑ cco:ont00001945 ;
    is inverse of cco:ont00001876.

@annotation( rdfs:label "has process part"@en )
@annotation( skos:definition "x has_process_part y iff x and y are instances of Process, such that y occurs during the temporal interval of x, and y either provides an input to x or receives an output of x, or both."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001777 ;
    ⊑ obo:BFO_0000117 ;
    has domain obo:BFO_0000015 ;
    has range obo:BFO_0000015 ;
    is inverse of cco:ont00001857.

@annotation( rdfs:label "has object"@en )
@annotation( skos:definition "If p is a process and c is a continuant, then p has object c if and only if p is performed by an agent and c is part of the projected state that agent intends to achieve by performing p."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001778 ;
    ⊑ obo:BFO_0000057 ;
    is inverse of cco:ont00001936.

@annotation( rdfs:label "has inside instant"@en )
@annotation( skos:definition "For Temporal Interval t1 and Temporal Instant t2, t1 has inside instant t2 if and only if there exists Temporal Instants t3 and t4 that are part of t1 and non-identical with t2, such that t3 is before t2 and t4 is after t2."@en )
@annotation( cco:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI )
Object property cco:ont00001779 ;
    has domain obo:BFO_0000038 ;
    has range obo:BFO_0000148 ;
    is inverse of cco:ont00001848.

@annotation( rdfs:label "has mother"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001780 ;
    ⊑ cco:ont00001842 ;
    is inverse of cco:ont00001786.

@annotation( rdfs:label "has step sister"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001781 ;
    ⊑ cco:ont00001996 ;
    is inverse of cco:ont00001979.

@annotation( rdfs:label "has all members located in"@en )
@annotation( skos:definition "x has all members located in y iff x is an instance of Object Aggregate and y is an instance of independent continuant but not a spatial region, and every member of x is located in y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001782 ;
    ⊑ cco:ont00001832 ;
    has domain obo:BFO_0000027 ;
    has range ( obo:BFO_0000004 ⊓ ¬ obo:BFO_0000006 ).

@annotation( rdfs:label "is granddaughter of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001783 ;
    ⊑ cco:ont00001945 ;
    is inverse of cco:ont00001820.

@annotation( rdfs:label "has son in law"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001784 ;
    ⊑ cco:ont00001818 ;
    is inverse of cco:ont00001881.

@annotation( rdfs:label "has uncle"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001785 ;
    ⊑ cco:ont00001865 ;
    is inverse of cco:ont00001988.

@annotation( rdfs:label "is mother of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001786 ;
    ⊑ cco:ont00001995.

@annotation( rdfs:label "agent in"@en )
@annotation( skos:definition "x agent_in y iff y is an instance of Process and x is an instance of Agent, such that x is causally active in y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001787 ;
    ⊑ obo:BFO_0000056 ;
    is inverse of cco:ont00001833.

@annotation( rdfs:label "has paternal aunt"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001788 ;
    ⊑ cco:ont00001789 ;
    is inverse of cco:ont00001994.

@annotation( rdfs:label "has aunt"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001789 ;
    ⊑ cco:ont00001865 ;
    is inverse of cco:ont00001955.

@annotation( rdfs:label "has maternal uncle"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001790 ;
    ⊑ cco:ont00001785 ;
    is inverse of cco:ont00001929.

@annotation( rdfs:label "coincides with"@en )
@annotation( skos:definition "An immaterial entity im1 coincides with some immaterial entity im2 iff im1 is a spatial part of im2 and im2 is a spatial part of im1."@en )
@annotation( skos:scopeNote "Given a stronger temporal interpretation, this property may be transitive and symmetric. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI )
Object property cco:ont00001791 ;
    ⊑ cco:ont00001810 ;
    has domain obo:BFO_0000141 ;
    has range obo:BFO_0000141.

@annotation( rdfs:label "has sister"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001792 ;
    ⊑ cco:ont00001902 ;
    is inverse of cco:ont00001851.

@annotation( rdfs:label "has half sister"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001793 ;
    ⊑ cco:ont00001975 ;
    is inverse of cco:ont00001948.

@annotation( rdfs:label "has subsidiary"@en )
@annotation( skos:definition "An Organization o1 has_subsidiary Organization o2 iff o1 controls o2 by having the capacity to determine the outcome of decisions about o2's financial and operating policies."@en )
@annotation( cco:ont00001754 "http://www.austlii.edu.au/legis/cth/consol_act/ca2001172/s50aa.html" )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001794 ;
    ⊑ cco:ont00001977 ;
    has domain cco:ont00001180 ;
    has range cco:ont00001180 ;
    is inverse of cco:ont00001815.

@annotation( rdfs:label "has inside interval"@en )
@annotation( skos:definition "A Temporal Interval INT2 has inside interval some Temporal Interval INT1 iff there exist Temporal Instants inst1, inst2, inst3, and inst4 such that inst1 is the starting instant of INT1, inst2 is the ending instant of INT1, inst3 is the starting instant of INT2, inst4 is the ending instant of INT2, inst3 is before inst1, and inst2 is before inst4."@en )
@annotation( cco:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI )
Object property cco:ont00001795 ;
