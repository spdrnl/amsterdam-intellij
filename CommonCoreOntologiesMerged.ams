@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class cco:ont00001332 ;
    ⊑ cco:ont00000610.

@annotation( rdfs:label "Rosy"@en )
@annotation( skos:definition "A Color consisting of red hue and yellow hue and high brightness."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI )
Class cco:ont00001333 ;
    ⊑ cco:ont00000378.

@annotation( rdfs:label "Act of Purchasing"@en )
@annotation( skos:definition "An Act of Financial Instrument Use wherein a Financial Instrument is used by an Agent (the Purchaser) to acquire a good or service from another Agent (the Provider)."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Purchasing&oldid=1050163120"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class cco:ont00001334 ;
    ⊑ cco:ont00000836.

@annotation( dcterms:creator "https://cubrc.org"^^xsd:anyURI )
@annotation( rdfs:label "Government"@en )
@annotation( skos:definition "An Organization that is the highest legitimate authority delimited by some Delimiting Domain and that exercises executive, legislative, or judicial authority in that Domain."@en )
@annotation( skos:editorialNote "Highest legitimate authority should not be confused with highest legitimate authority of a particular kind. For example, while the judicial branch of the United States government has the highest judicial authority in a Delimiting Domain, it is not the highest legitimate authority delimited by that domain. The combination of executive, judicial, and legislative branches is higher because it wields more legitimate authority than any branch on its own."@en )
@annotation( skos:editorialNote "Importantly, the definition states \"highest legitimate authority delimited by some Delimiting Domain\" and not \"highest legitimate authority in some Delimiting Domain.\" The government of Wales is the highest legitimate authority delimited by some Delimiting Domain but it is not the highest legitimate authority in that domain, which would be the government of the United Kingdom."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Government&oldid=1063736308"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Class cco:ont00001335 ;
    ⊑ cco:ont00001180 ;
    ⊑ ∃ cco:ont00001859 cco:ont00001203.

@annotation( rdfs:comment "The relation between the owner and property may be private, collective, or common and the property may be objects, land, real estate, or intellectual property."@en )
@annotation( rdfs:label "Act of Ownership"@en )
@annotation( skos:definition "An Act of Possession that includes an agent having certain rights and duties over the property owned."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ownership&oldid=1058224617"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class cco:ont00001336 ;
    ⊑ cco:ont00001232.

@annotation( rdfs:label "Infrared Light Frequency"@en )
@annotation( skos:definition "An Electromagnetic Radiation Frequency of some Electromagnetic Wave that is between 300 gigahertz and 430 tetrahertz."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Infrared&oldid=1064111319"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class cco:ont00001337 ;
    ⊑ cco:ont00000754.

@annotation( rdfs:label "Timbre"@en )
@annotation( skos:definition "A Sound Process Profile that is characterized by the variation, spectrum, or envelope of translated sound waves, typically on a continuum from dull or dark to bright."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class cco:ont00001338 ;
    ⊑ cco:ont00000862.

@annotation( rdfs:label "Act of Walking"@en )
@annotation( skos:definition "An Act of Travel that proceeds by foot."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class cco:ont00001339 ;
    ⊑ cco:ont00000890.

@annotation( rdfs:label "Calendar Date Identifier"@en )
@annotation( skos:definition "A Date Identifier that designates some Day by using a combination of Day, Week, Month, or Year Identifiers formatted according to an implementation of a Calendar System."@en )
@annotation( skos:example "January 1, 2018; 1 January 2018; 01/01/18; 01Jan18" )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Class cco:ont00001340 ;
    ⊑ cco:ont00000529.

@annotation( rdfs:label "Portion of Geosphere"@en )
@annotation( skos:definition "A fiat object part that is composed of one or more portions of the atmosphere, cryosphere, hydrosphere, or lithosphere"@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Geosphere&oldid=1137306949"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI )
Class cco:ont00001341 ;
    ⊑ obo:BFO_0000024.

@annotation( rdfs:label "Infantry Fighting Vehicle"@en )
@annotation( skos:definition "An Armored Fighting Vehicle that is designed to carry infantry into battle and to provide fire support for them."@en )
@annotation( skos:scopeNote "Infantry Fighting Vehicles (IFVs) are differentiated from Armored Personnel Carriers (APCs) because they are designed to give direct fire support to the dismounted infantry and so usually have significantly enhanced armament. IFVs also often have improved armour and firing ports (allowing the infantry to fire personal weapons while mounted)."@en )
@annotation( cco:ont00001753 "IFV" )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Infantry_fighting_vehicle&oldid=1062470745"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00001342 ;
    ⊑ cco:ont00000427.

@annotation( rdfs:label "Circuit Breaker"@en )
@annotation( skos:definition "A Material Artifact that is designed to protect an electrical circuit from damage caused by excess current from an overload or short circuit."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Circuit_breaker&oldid=1060854893"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00001343 ;
    ⊑ cco:ont00000995.

@annotation( rdfs:label "Biological Depot"@en )
@annotation( skos:definition "A Storage Facility that is designed to store biological agents."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI )
Class cco:ont00001344 ;
    ⊑ cco:ont00000881.

@annotation( rdfs:label "Measurement Unit of Impulse"@en )
@annotation( skos:definition "A Measurement Unit that is used as a standard for measurement of the integral of a Force applied to a portion of matter over a temporal interval."@en )
@annotation( skos:example "N s, dyne second" )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI )
Class cco:ont00001345 ;
    ⊑ cco:ont00000120.

@annotation( rdfs:label "Legal Instrument"@en )
@annotation( skos:definition "A Material Artifact that is designed as a formally executed written document that can be formally attributed to its author, records and formally expresses a legally enforceable act, process, or contractual duty, obligation, or right, and therefore evidences that act, process, or agreement."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Legal_instrument&oldid=1054387344"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00001346 ;
    ⊑ cco:ont00000995.

@annotation( rdfs:label "Behavior"@en )
@annotation( skos:definition "An Act in which an Independent Continuant participates as an Agent in response to external or internal stimuli and following some pattern which is dependent upon some combination of that Independent Continuant's internal state and external conditions."@en )
@annotation( cco:ont00001754 "http://purl.obolibrary.org/obo/GO_0007610" )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class cco:ont00001347 ;
    ⊑ cco:ont00000005.

@annotation( rdfs:comment "For an object in motion, its Three-Dimensional Position is part of its Three-Dimensional Path."@en )
@annotation( rdfs:label "Three-Dimensional Position"@en )
@annotation( skos:definition "A Three-Dimensional Spatial Region that encompasses the (minimal) spatial region in which some object is located at a particular time."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI )
Class cco:ont00001348 ;
    ⊑ obo:BFO_0000028.

@annotation( rdfs:label "Grey"@en )
@annotation( skos:definition "A Color between white and black colors."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI )
Class cco:ont00001349 ;
    ⊑ cco:ont00000378.

@annotation( rdfs:label "Thermal Control Artifact Function"@en )
@annotation( skos:definition "An Artifact Function that is realized by an Artifact increasing, decreasing, or maintaining the temperature of itself, a part of itself, or another object."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00001350 ;
    ⊑ cco:ont00000323.

@annotation( rdfs:label "Cartesian Coordinate System"@en )
@annotation( skos:altLabel "Rectangular Coordinate System"@en )
@annotation( skos:definition "A Spatial Reference System that identifies each point in a spatial region of n-dimensions using an ordered n-tuple of numerical coordinates that are the signed (i.e. positive or negative) distances measured in the same unit of length from the zero point where the fixed perpendicular Coordinate System Axes meet."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Cartesian_coordinate_system&oldid=1058613323"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Class cco:ont00001351 ;
    ⊑ cco:ont00000275.

@annotation( rdfs:comment "Greenwich Mean Time (GMT) is the mean solar time at the Royal Observatory in Greenwich, London and has been superseded by Coordinated Universal Time (UTC)."@en )
@annotation( rdfs:label "Greenwich Mean Time Zone Identifier"@en )
@annotation( skos:definition "A Time Zone Identifier that designates a spatial region where the local time is calculated according to the specified offset from Greenwich Mean Time."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Class cco:ont00001352 ;
