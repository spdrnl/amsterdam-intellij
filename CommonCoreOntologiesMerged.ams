    ⊑ obo:BFO_0000023.

@annotation( rdfs:label "Color Saturation"@en )
@annotation( skos:definition "An Optical Property that inheres in a bearer in virtue of its capacity to reflect high intensity light distributed across fewer wavelengths, typically considered on a continuum of purity."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI )
