@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Marriage&oldid=1064076951"^^xsd:anyURI )
@annotation( cco:ont00001754 "Haviland, William A.; Prins, Harald E. L.; McBride, Bunny; Walrath, Dana (2011). Cultural Anthropology: The Human Challenge (13th ed.). Cengage Learning. ISBN 978-0-495-81178-7" )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class cco:ont00000895 ;
    ⊑ cco:ont00000335.

@annotation( rdfs:label "Mean Point Estimate Information Content Entity"@en )
@annotation( skos:altLabel "Arithmetic Mean"@en )
@annotation( skos:altLabel "Average"@en )
@annotation( skos:altLabel "Mean"@en )
@annotation( skos:definition "A Point Estimate Information Content Entity that is a measurement of a set of values and is equal to the sum of all the values in the set divided by the total number of values in the set."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Class cco:ont00000896 ;
    ⊑ cco:ont00000745.

@annotation( rdfs:comment "Oxidizers are essential participants in many processes including combustion and rusting. Hence, a portion of oxidizer must always be present along with a portion of fuel in order for combustion to occur."@en )
@annotation( rdfs:label "Portion of Oxidizer"@en )
@annotation( skos:altLabel "Portion of Oxidant"@en )
@annotation( skos:altLabel "Portion of Oxidizing Agent"@en )
@annotation( skos:definition "A Portion of Material that is disposed to steal electrons from other substances (i.e. to oxidize other substances) as a participant in a reduction-oxidation process."@en )
@annotation( skos:example "oxygen, hydrogen peroxide, chlorine, sulfiric acid, potassium nitrate" )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00000897 ;
    ⊑ cco:ont00000457.

