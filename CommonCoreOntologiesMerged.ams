@annotation( rdfs:comment "Tank firepower is normally provided by a large-caliber main gun mounted in a rotating turret, which is supported by secondary machine guns. A tank's heavy armour and all-terrain mobility provide protection for both the tank and its crew, allowing it to perform all primary tasks of the armoured troops on the battlefield."@en )
@annotation( rdfs:label "Tank"@en )
@annotation( skos:definition "An Armored Fighting Vehicle that is designed to carry heavy firepower, have a powerful Engine, and travel on one or more continuous tracks such that it is suitable for front-line combat and can provide operational maneuverability as well as tactical offensive and defensive capabilities."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Tank&oldid=1060527612"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00001319 ;
    ⊑ cco:ont00000427.

@annotation( rdfs:label "Radio Transceiver"@en )
@annotation( skos:definition "A Radio Communication Instrument that is an electronic device composed of both a Radio Transmitter and a Radio Receiver that share common circuitry or a single housing."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Transceiver&oldid=1058453736"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00001320 ;
    ⊑ cco:ont00000903.

@annotation( rdfs:label "Lead Acid Electric Battery"@en )
@annotation( skos:definition "A Secondary Cell Electric Battery that has a lead anode and lead oxide cathode."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Lead%E2%80%93acid_battery&oldid=1061641405"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00001321 ;
    ⊑ cco:ont00001105.

@annotation( rdfs:comment "For the most part Generically Dependent Continuants do not inhere in their bearers over some continuous scale. The primary exception is religion and this class allows annotation of those cases where an Agent is described as becoming less religious. Other cases would include the decrease of an organization's bearing of some objective."@en )
@annotation( rdfs:label "Decrease of Generically Dependent Continuant"@en )
@annotation( skos:definition "A Decrease of Dependent Continuant in which some Independent Continuant has a decrease in the level of a Generically Dependent Continuant that it bears."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class cco:ont00001322 ;
    ⊑ cco:ont00000726.

@annotation( rdfs:label "Bearing Artifact Function"@en )
@annotation( skos:definition "An Artifact Function that is realized in processes in which the Artifact constrains relative motion to only the desired motion, and reduces friction between moving parts."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/wiki/Bearing_(mechanical)" )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00001323 ;
    ⊑ cco:ont00000323.

@annotation( rdfs:label "Process Regulation"@en )
@annotation( skos:definition "A Directive Information Content Entity that prescribes an Process as required, prohibited, or permitted, and is the output of an Process which realizes some Authority Role."@en )
@annotation( skos:scopeNote "Although regulations often regulate processes which involve agents--as the regulating or regulated participant--it is unclear how causally active an agents need to be in those regulated processes. For example, it is not clear how causally active a human agent is in the process of a traffic light regulating the motion of a self-driving vehicle."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Class cco:ont00001324 ;
    ⊑ cco:ont00000965.

@annotation( rdfs:label "Act of Renting"@en )
@annotation( skos:definition "An Act of Purchasing wherein a Financial Instrument is used by an Agent (the Renter) as a payment to acquire temporary possession or use of a good or property that is owned or controlled by another Agent (the Seller)."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class cco:ont00001325 ;
    ⊑ cco:ont00001334.

@annotation( rdfs:label "Land Transportation Artifact"@en )
@annotation( skos:definition "A Transportation Artifact that is fixed in place and designed to bear a Function, the realization of which is sometimes part of a process moving Vehicles and Agents from one location to another via land."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00001326 ;
    ⊑ cco:ont00000254.

@annotation( rdfs:label "Social Act"@en )
@annotation( skos:definition "A Planned Act having an objective that affects, is performed by, or is performed on behalf of, a community or group of Persons."@en )
@annotation( cco:ont00001754 "http://en.wiktionary.org/wiki/commually" )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
Class cco:ont00001327 ;
    ⊑ cco:ont00000228.

@annotation( rdfs:label "Temporal Reference System"@en )
@annotation( skos:altLabel "Temporal Reference Frame"@en )
@annotation( skos:altLabel "Time Scale"@en )
@annotation( skos:definition "A Reference System that describes a set of standards for measuring time as well as understanding the context of and organizing temporal data."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Class cco:ont00001328 ;
    ⊑ cco:ont00000398.

@annotation( rdfs:label "Education Artifact Function"@en )
@annotation( skos:definition "A Service Artifact Function that is realized in processes of transmiting accumulated knowledge skills and values from one generation to another."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Education&oldid=1064011752"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00001329 ;
    ⊑ cco:ont00001301.

@annotation( rdfs:label "Telemetry Process"@en )
@annotation( skos:definition "A Mechanical Process that is highly automated and in which measurements are made or other data is collected and transmitted to receiving equipment to facilitate the monitoring of environmental conditions or equipment parameters at a remote or inaccessible location."@en )
@annotation( skos:example "using a GPS tag to track a shark's migratory pattern" )
@annotation( skos:example "using a portable cardiac monitor to remotely collect data on a patient's heart activity (biotelemetry)" )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telemetry&oldid=1061697851"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI )
