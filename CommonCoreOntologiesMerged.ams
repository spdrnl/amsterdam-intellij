@annotation( rdfs:comment "Four of the subtypes of measurements used here (Interval, Nominal, Ordinal, and Ratio) were originally defined by S.S. Stevens in the article \"On the Theory of Scales of Measurement\" in Science, Vol. 103 No. 2684 on June 7, 1946. For an introductory article with links to additional content including criticisms and alternate classifications of measurements see https://en.wikipedia.org/wiki/Level_of_measurement"@en )
@annotation( rdfs:label "Interval Measurement Information Content Entity"@en )
@annotation( skos:definition "A Measurement Information Content Entity that places a Quality of an Entity onto some interval scale having no true zero value."@en )
@annotation( skos:example "The sentence \"The temperature reached -27 degrees Fahrenheit on January 20, 1985 in Chicago, IL.\" is the carrier of an interval measurement as 0 degrees on the Fahrenheit scale does not describe absolute zero."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Class cco:ont00001364 ;
    ⊑ cco:ont00001163 ;
    is equivalent to ( cco:ont00001163 ⊓ ∃ cco:ont00001877 obo:BFO_0000001 ) ;
    is disjoint with cco:ont00000293 ;
    is disjoint with cco:ont00001010 ;
    is disjoint with cco:ont00001022.

@annotation( rdfs:label "Maximum Speed Artifact Function"@en )
@annotation( skos:definition "A Speed Artifact Function that is realized in some process in which the Artifact bearing the Artifact Function attains the highest speed at which that Artifact is designed to operate."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI )
Class cco:ont00001365 ;
