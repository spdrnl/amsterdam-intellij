@annotation( rdfs:label "Optical Focusing Artifact Function"@en )
@annotation( skos:definition "An Optical Processing Artifact Function that is realized by an Artifact participating in a light focusing event in which the Artifact causes the light beam to converge on a target spatial point."@en )
