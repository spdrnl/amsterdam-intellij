@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001955 ;
    ⊑ cco:ont00001865.

@annotation( rdfs:label "aggregate has disposition"@en )
@annotation( skos:definition "x aggregate_has_disposition y iff x is an instance of Object Aggregate and y is an instance of Disposition, such that x aggregate_bearer_of y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001956 ;
    ⊑ cco:ont00001836 ;
    has domain obo:BFO_0000027 ;
    has range obo:BFO_0000016.

@annotation( rdfs:label "is husband of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001957 ;
    ⊑ cco:ont00001804.

@annotation( rdfs:label "has maternal aunt"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001958 ;
    ⊑ cco:ont00001789.

@annotation( rdfs:label "inhibits"@en )
@annotation( skos:definition "x inhibits y iff x and y are non-identical Processes, d is a Decrease of Realizable Entity, and x is_cause_of d, and r is a Realizable Entity, and d has_participant r, and r realized_in y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001959 ;
    has domain obo:BFO_0000015 ;
    has range obo:BFO_0000015 ;
    is inverse of cco:ont00001970.

@annotation( rdfs:label "has maternal grandmother"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001960 ;
    ⊑ cco:ont00001840.

@annotation( rdfs:label "is measurement unit of"@en )
@annotation( skos:definition "x is_measurement_unit_of y iff y is an instance of Information Bearing Entity and x is an instance of Measurement Unit, such that x describes the magnitude of measured physical quantity mentioned in y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Object property cco:ont00001961 ;
    ⊑ obo:BFO_0000084 ;
    has domain cco:ont00000120 ;
    has range cco:ont00000253.

@annotation( rdfs:label "process started by"@en )
@annotation( skos:definition "x process_started_by y iff x and y are instances of processes, and x is caused_by y, and i is an instance of a temporal instant, and r is an instant of a temporal interval, and x has starting instance i, and y occurs on r, and r interval contains i."@en )
@annotation( skos:scopeNote "A process x is started by another process y when y causes x while y is still occurring."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001962 ;
    ⊑ cco:ont00001819.

@annotation( rdfs:label "is measured by ordinal"@en )
@annotation( skos:definition "y is_measured_by_ordinal x iff x is an instance of Information Content Entity and y is an instance of Entity, such that x describes some attribute of y relative to a scale ordered by rank."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Object property cco:ont00001963 ;
    ⊑ cco:ont00001904 ;
    has range cco:ont00001010.

@annotation( rdfs:label "is measured by interval"@en )
@annotation( skos:definition "y is_measured_by_interval x iff x is an instance of Information Content Entity and y is an instance of Entity, such that x describes some attribute of y relative to a scale which has uniform intervals but has a zero value that does not correspond to an absence of the attribute being measured."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Object property cco:ont00001964 ;
    ⊑ cco:ont00001904 ;
    has range cco:ont00001364.

@annotation( rdfs:label "is measured by ratio"@en )
@annotation( skos:definition "y is_measured_by_ratio x iff x is an instance of Information Content Entity and y is an instance of Entity, such that x describes some attribute of y relative to a scale having equal unit values and a zero value that corresponds to the absence of the attribute being measured."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Object property cco:ont00001965 ;
    ⊑ cco:ont00001904 ;
    has range cco:ont00001022 ;
    is inverse of cco:ont00001983.

@annotation( rdfs:comment "This object property, as well as all of its children are typified as functional properties. This means that for instances x, y, and z if x is a measurement of y and x is a measurement of z, then y = z."@en )
@annotation( rdfs:label "is a measurement of"@en )
@annotation( skos:definition "x is_a_measurement_of y iff x is an instance of Information Content Entity and y is an instance of Entity, such that x describes some attribute of y relative to some scale or classification scheme."@en )
@annotation( skos:scopeNote "Given a stronger temporal interpretation, this property may be functional. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Object property cco:ont00001966 ;
    ⊑ cco:ont00001982 ;
    has domain cco:ont00001163.

@annotation( rdfs:label "is nephew of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001967 ;
    ⊑ cco:ont00001865 ;
    is inverse of cco:ont00001969.

@annotation( rdfs:label "is descendent of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001968 ;
    ⊑ cco:ont00001865.

@annotation( rdfs:label "has nephew"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001969 ;
    ⊑ cco:ont00001865.

@annotation( rdfs:label "inhibited by"@en )
@annotation( skos:definition "y inhibited_by x iff x and y are non-identical Processes, d is a Decrease of Realizable Entity, and x is_cause_of d, and r is a Realizable Entity, and d has_participant r, and r realized_in y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001970 ;
    has domain obo:BFO_0000015 ;
    has range obo:BFO_0000015.

@annotation( rdfs:label "interval contained by"@en )
@annotation( skos:definition "A Temporal Interval INT1 is contained by some Temporal Interval INT2 iff there exist Temporal Instants inst1, inst2, inst3, and inst4 such that inst1 is the starting instant of INT1, inst2 is the ending instant of INT1, inst3 is the starting instant of INT2, inst4 is the ending instant of INT2, inst3 is before or identical to inst1, inst2 is before or identical to inst4, and it is not the case that both inst3 is identical to inst1 and inst2 is identical to inst4."@en )
@annotation( cco:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI )
Object property cco:ont00001971 ;
    has domain obo:BFO_0000038 ;
    has range obo:BFO_0000038.

@annotation( rdfs:label "has paternal grandfather"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001972 ;
    ⊑ cco:ont00001776.

@annotation( rdfs:label "has maternal grandfather"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001973 ;
    ⊑ cco:ont00001776.

@annotation( rdfs:label "requires"@en )
@annotation( skos:definition "x requires y at t iff: x is an instance of Process Regulation at time t, and y is an instance of Process at time t, and x prescribes that some y must occur."@en )
@annotation( skos:scopeNote "Given a stronger temporal interpretation, this property may be asymmetric and irreflexive. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001974 ;
    ⊑ cco:ont00001942 ;
    has domain cco:ont00001324 ;
    has range obo:BFO_0000015.

@annotation( rdfs:label "is half-sibling of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001975 ;
    ⊑ cco:ont00001865 ;
    is inverse of cco:ont00001975 ;
    has characteristics( symmetric ).

@annotation( rdfs:label "uses language"@en )
@annotation( skos:definition "x uses_language y iff x is an instance of an Information Bearing Entity and y is an instance of a Language such that the literal value of x is a string that is encoded according to the syntax of y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Object property cco:ont00001976 ;
    ⊑ cco:ont00001920 ;
    has domain cco:ont00000253 ;
    has range cco:ont00001175.

@annotation( rdfs:label "has affiliate"@en )
@annotation( skos:definition "x is_affiliated_with y iff x and y are instances of Agent, such that they have any kind of social or business relationship."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001977 ;
    has domain ( cco:ont00001017 ⊔ cco:ont00001180 ⊔ cco:ont00001262 ) ;
    has range ( cco:ont00001017 ⊔ cco:ont00001180 ⊔ cco:ont00001262 ).

@annotation( rdfs:label "receives"@en )
@annotation( skos:definition "x receives y iff x is an instance of Agent and y is an instance of Act Of Communication, such that x is the recipient and decoder of the InformationContentEntity intended for communication in y."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001978 ;
    ⊑ obo:BFO_0000056 ;
    has domain cco:ont00001017.

@annotation( rdfs:label "is step-sister of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001979 ;
    ⊑ cco:ont00001996.

@annotation( rdfs:label "describes condition"@en )
@annotation( skos:definition "p describes_condition c iff p is an instance of a Performance Specification, and p has part d, and d is an instance of a Descriptive Information Content Entity, and p prescribes an entity s, and d describes c, and c is an entity that is causally relevant to s existing as prescribed by p."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Object property cco:ont00001980 ;
    ⊑ cco:ont00001808.

@annotation( rdfs:label "has grandson"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001981 ;
    ⊑ cco:ont00001850.

@annotation( rdfs:comment "It is possible that this relation should be a functional property, that is for all x, y, z if x describes y and x describes z then y = z. For example, if a financial report x describes the quarterly results of a company y and that same financial report describes the quarterly results of a company z, then it should be inferred that companies y and z are the same. We refrained from classifying the relation as a functional property on the concern that descriptions are multifaceted and so consequently it may be that the same report would contain descriptions of multiple entities."@en )
@annotation( rdfs:label "describes"@en )
@annotation( skos:definition "x describes y iff x is an instance of Information Content Entity, and y is an instance of Entity, such that x is about the characteristics by which y can be recognized or visualized."@en )
@annotation( skos:example "the content of a newspaper article describes some current event" )
@annotation( skos:example "the content of a visitor's log describes some facility visit" )
@annotation( skos:example "the content of an accident report describes some accident" )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Object property cco:ont00001982 ;
    ⊑ cco:ont00001808 ;
    has domain cco:ont00000853.

@annotation( rdfs:label "is a ratio measurement of"@en )
@annotation( skos:definition "x is_a_ratio_measurement_of y iff x is an instance of Information Content Entity and y is an instance of Entity, such that x describes some attribute of y relative to a scale having equal unit values and a zero value that corresponds to the absence of the attribute being measured."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Object property cco:ont00001983 ;
    ⊑ cco:ont00001966 ;
    has domain cco:ont00001022.

@annotation( dcterms:created "2022-12-30T21:32:27-05:00"^^xsd:dateTime )
@annotation( dcterms:creator "https://cubrc.org"^^xsd:anyURI )
@annotation( rdfs:label "has interest in"@en )
@annotation( skos:definition "A relation between an entity and some process where the entity has an interest in that process."@en )
@annotation( skos:editorialNote "This term is meant to be weakly normative. The only sense in which the process is of positive normative value is that it's prescribed by the entity, or historically of evolutionary benefit to the entity's ancestors, or facilitates a process the entity has an interest in for the prior two reasons. The process an entity has an interest could in many or all ways be harmful to the entity."@en )
@annotation( skos:prefLabel "has interest in"@en )
@annotation( skos:scopeNote "There are four conditions in which an entity has an interest in some process. 1) Biological Condition: If a part (including improper part) of an organism has a function, then that organism has an interest in the realization of that function. 2) Artifactual Condition: If a part (including improper part) of an artifact has a function, then some agent or group of agents, at some time, has an interest in the realization of that function. 3) Prescription Condition: If an agent or group of agents has a plan, then it has an interest in the realization of all the processes and process-combinations prescribed by that plan. 4) Facilitation Condition: If (a) x has an interest in the realization of a disposition y, and (b) the realization of a disposition z facilitates the realization of disposition y, then (c) x has an interest in the realization of disposition z, and by 'facilitates' we mean that the occurrence of a process w, which realizes realization of z is either (1) required for y, to realize or (2) would contribute positively to the grade of, y's realization."@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001984 ;
    has domain cco:ont00001017 ;
    has range obo:BFO_0000015.

@annotation( rdfs:label "is father of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001985 ;
    ⊑ cco:ont00001995.

@annotation( rdfs:label "has output"@en )
@annotation( skos:definition "y has_output x iff x is an instance of Continuant and y is an instance of Process, such that the presence of x at the end of y is a necessary condition for the completion of y."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=IPO_model&oldid=1024398398"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001986 ;
    ⊑ obo:BFO_0000057 ;
    has domain obo:BFO_0000015 ;
    has range obo:BFO_0000002.

@annotation( rdfs:label "has daughter"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001987 ;
    ⊑ cco:ont00001995.

@annotation( rdfs:label "is uncle of"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI )
Object property cco:ont00001988 ;
    ⊑ cco:ont00001865.

@annotation( rdfs:label "has nontangential part"@en )
@annotation( skos:definition "x has_nontangential_part y iff x and y are instances of Immaterial Entity, and x has_spatial_part y, such that there does not exist another instance of an Immaterial Entity which externally connects with both x and y."@en )
@annotation( skos:scopeNote "Given a stronger temporal interpretation, this property may be transitive. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en )
@annotation( cco:ont00001754 "Randell, D. A., Cui, Z. and Cohn, A. G.: 1992, \"A spatial logic based on regions and connection,\" Proc. 3rd Int. Conf. on Knowledge Representation and Reasoning, Morgan Kaufmann, San Mateo, pp. 165-176. Available at: https://www.dpi.inpe.br/gilberto/references/cohn_rcc.pdf"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI )
Object property cco:ont00001989 ;
    ⊑ cco:ont00001855 ;
    has domain obo:BFO_0000141 ;
    has range obo:BFO_0000141.

@annotation( rdfs:label "instant is before"@en )
@annotation( skos:definition "A temporal instant t1 (a instance of a zero-dimensional temporal region) is before another temporal instant t2 iff there exists some instance of a temporal interval ti1 such that t1 is the starting instant of ti1 and t2 is the ending instant of ti1."@en )
@annotation( skos:scopeNote "'instant is before' is a primitive relationship. Informally, a temporal instant t1 is before some temporal instant t2 if and only if t1 precedes t2."@en )
@annotation( cco:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI )
Object property cco:ont00001990 ;
    has domain obo:BFO_0000148 ;
    has range obo:BFO_0000148 ;
    has characteristics( transitive ).

@annotation( rdfs:label "is made of"@en )
@annotation( skos:definition "An object o is made of an object m when m is the material that o consists of and that material does not undergo a change of kind during the creation of o"@en )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI )
Object property cco:ont00001991 ;
    ⊑ owl:topObjectProperty ;
    has domain obo:BFO_0000030 ;
    has range obo:BFO_0000030.

@annotation( rdfs:label "has organizational context"@en )
@annotation( skos:definition "x has_organizational_context y iff y is an instance of an Organization and x is an instance of a Role and z is an instance of a Person, such that z's affiliation with y is a prerequisite for z bearing x or y ascribes x to the bearer of x."@en )
