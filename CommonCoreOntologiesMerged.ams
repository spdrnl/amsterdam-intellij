@annotation( rdfs:comment "Note that, while reference systems and reference frames are treated as synonyms here, some people treat them as related but separate entities. See: http://www.ggos-portal.org/lang_en/GGOS-Portal/EN/Topics/GeodeticApplications/GeodeticReferenceSystemsAndFrames/GeodeticReferenceSystemsAndFrames.html"@en )
@annotation( rdfs:label "Spatial Reference System"@en )
@annotation( skos:altLabel "Coordinate System"@en )
@annotation( skos:altLabel "Spatial Coordinate System"@en )
@annotation( skos:altLabel "Spatial Reference Frame"@en )
@annotation( skos:definition "A Reference System that describes a set of standards for uniquely identifying the position of an entity or the direction of a vector within a defined spatial region by means of measurements along one or more Coordinate System Axes."@en )
@annotation( cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Coordinate_system&oldid=1060461397"^^xsd:anyURI )
@annotation( cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI )
Class cco:ont00000275 ;
    ⊑ cco:ont00000398.

@annotation( rdfs:label "Solar Calendar System"@en )
@annotation( skos:definition "A Calendar System that is designed to organize and identify dates based on the cycles of an Astronomical Body's Orbit around the Sun."@en )
@annotation( skos:scopeNote "Unless otherwise specified, a Solar Calendar System is assumed to be relative to the Orbit of the Earth around the Sun."@en )
